@page "/hr/payroll"
@page "/hr/payroll/{PeriodOffset:int}"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireHR")]
@using NewHeights.TimeClock.Shared.Audit
@using NewHeights.TimeClock.Shared.Constants
@using NewHeights.TimeClock.Shared.Enums
@using NewHeights.TimeClock.Data
@using NewHeights.TimeClock.Data.Entities
@using NewHeights.TimeClock.Web.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Text
@inject IDbContextFactory<TimeClockDbContext> DbFactory
@inject ITimesheetService TimesheetService
@inject ISubstituteTimesheetService SubTimesheetService
@inject IPayPeriodService PayPeriodService
@inject IEmailService EmailService
@inject IAuditService Audit
@inject IPayrollPdfService PayrollPdf
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<HRPayroll> Logger

<PageTitle>Payroll Review - @AppConstants.Branding.ShortName</PageTitle>

<div class="hr-payroll-page">
    <header class="payroll-header">
        <div class="header-info">
            <h1>Payroll Review</h1>
            <p class="subtitle">Final approval and export for Ascender HCM</p>
        </div>
        <div class="header-actions">
            <div class="period-nav">
                <label for="hr-pp-picker" class="pp-label">Pay Period:</label>
                <select id="hr-pp-picker" class="btn-nav pp-select"
                        value="@selectedPayPeriodId"
                        @onchange="OnPayPeriodChangedAsync"
                        disabled="@isLoading">
                    @foreach (var p in availablePeriods)
                    {
                        <option value="@p.PayPeriodId">
                            @p.PeriodName (@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy"))
                            @(p.IsOpen ? " · Current" : "")
                        </option>
                    }
                </select>
                @if (currentPayPeriod != null)
                {
                    <span class="period-dates">Pay: @currentPayPeriod.PayDate.ToString("MMM d")</span>
                }
            </div>
        </div>
    </header>

    <div class="status-overview">
        <div class="status-card">
            <span class="status-value">@payrollSummaries.Count</span>
            <span class="status-label">Hourly Employees</span>
        </div>
        <div class="status-card">
            <span class="status-value">@payrollSummaries.Sum(p => p.TotalHours).ToString("F2")</span>
            <span class="status-label">Hourly Hours</span>
        </div>
        <div class="status-card">
            <span class="status-value">@subPayrollSummaries.Count</span>
            <span class="status-label">Substitutes</span>
        </div>
        <div class="status-card">
            <span class="status-value">@subPayrollSummaries.Sum(s => s.TotalPeriods)</span>
            <span class="status-label">Sub Periods</span>
        </div>
    </div>

    <div class="payroll-tabs" role="tablist">
        <button type="button"
                class="payroll-tab @(activeTab == "hourly" ? "active" : "")"
                role="tab"
                aria-selected="@(activeTab == "hourly")"
                @onclick='() => SetTab("hourly")'>
            Hourly
        </button>
        <button type="button"
                class="payroll-tab @(activeTab == "substitutes" ? "active" : "")"
                role="tab"
                aria-selected="@(activeTab == "substitutes")"
                @onclick='() => SetTab("substitutes")'>
            Substitutes
        </button>
    </div>

    @if (activeTab == "hourly")
    {
        @if (isLoading)
        {
            <div class="loading">Loading...</div>
        }
        else
        {
            <div class="payroll-actions-bar">
                <select @bind="filterStatus">
                    <option value="all">All</option>
                    <option value="pending_hr">Ready for HR</option>
                    <option value="approved">Approved</option>
                </select>
                <span class="selection-counter" title="Rows checked for paper-approve + export">
                    @selectedHourlyIds.Count of @FilteredSummaries.Count() selected
                </span>
                <button class="btn-approve-export" @onclick="ApproveSelectedAndExportPdfAsync"
                        disabled="@(selectedHourlyIds.Count == 0 || isApprovingExport)"
                        title="Paper-approve every checked row (Employee + Supervisor + HR) and download a combined PDF">
                    @(isApprovingExport ? "Working…" : $"Approve Selected & Export PDF ({selectedHourlyIds.Count})")
                </button>
                <button class="btn-export" @onclick="ExportToCSV" disabled="@(!allHRApproved)">Export CSV</button>
            </div>
            @if (!string.IsNullOrEmpty(approveExportMsg))
            {
                <div class="approve-export-msg @(approveExportIsError ? "error" : "ok")" role="alert">@approveExportMsg</div>
            }

            <table class="payroll-table">
                <thead>
                    <tr>
                        <th class="check-col">
                            <input type="checkbox"
                                   title="Select all visible rows"
                                   @onchange="ToggleAllHourlyChecked"
                                   checked="@AllHourlyChecked" />
                        </th>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Regular</th>
                        <th>OT</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Exceptions</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in FilteredSummaries)
                    {
                        <tr class="@(emp.ExceptionCount > 0 && !emp.HRApproved ? "has-exception" : emp.HRApproved ? "approved" : emp.SupervisorApproved ? "ready" : "pending")">
                            <td class="check-col">
                                <input type="checkbox"
                                       title="Approve (paper) and add to PDF export"
                                       checked="@selectedHourlyIds.Contains(emp.EmployeeId)"
                                       @onchange="@((ChangeEventArgs e) => ToggleHourlyChecked(emp.EmployeeId, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>@emp.EmployeeName<br/><small>@emp.IdNumber</small></td>
                            <td>@emp.SupervisorName</td>
                            <td>@emp.RegularHours.ToString("F2")</td>
                            <td>@emp.OvertimeHours.ToString("F2")</td>
                            <td><strong>@emp.TotalHours.ToString("F2")</strong></td>
                            <td>
                                @(emp.EmployeeApproved ? "E✓" : "E⏳")
                                @(emp.SupervisorApproved ? "S✓" : "S⏳")
                                @(emp.HRApproved ? "HR✓" : "HR⏳")
                            </td>
                            <td class="exc-cell">
                                @if (emp.ExceptionCount > 0)
                                {
                                    <button type="button"
                                            class="exc-link"
                                            title="View @emp.ExceptionCount exception(s)"
                                            @onclick="() => ViewExceptions(emp.EmployeeId)">
                                        ⚠ @emp.ExceptionCount
                                    </button>
                                }
                                else
                                {
                                    <span class="exc-none" aria-hidden="true">—</span>
                                }
                            </td>
                            <td>
                                <button @onclick="() => ViewDetails(emp.EmployeeId)">View</button>
                                @if (emp.SupervisorApproved && !emp.HRApproved)
                                {
                                    <button @onclick="() => ApproveEmployee(emp.EmployeeId)">Approve</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (payPeriodExported)
            {
                <div class="export-info">Exported on @exportedDate?.ToString("MMM d") by @exportedBy</div>
            }
        }
    }
    else if (activeTab == "substitutes")
    {
        <SubstitutePayrollSection PeriodStart="@currentPayPeriod?.StartDate"
                                  PeriodEnd="@currentPayPeriod?.EndDate"
                                  CurrentUserEmail="@currentUserEmail" />
    }
</div>

@code {
    [Parameter] public int PeriodOffset { get; set; } = 0;

    private int periodOffset = 0;
    private bool isLoading = true;
    private string currentUserEmail = "";
    private PayPeriodInfo? currentPayPeriod;
    private List<PayrollSummary> payrollSummaries = new();

    // 2026-04-27: per-row checkbox state for "Approve & Add to Export". Each
    // checked employee is paper-approved (3 stages) AND included in the
    // combined PDF when the "Approve Selected & Export PDF" button is clicked.
    private HashSet<int> selectedHourlyIds = new();
    private bool isApprovingExport = false;
    private string approveExportMsg = "";
    private bool approveExportIsError = false;
    private bool AllHourlyChecked => FilteredSummaries.Any() && FilteredSummaries.All(e => selectedHourlyIds.Contains(e.EmployeeId));

    private void ToggleHourlyChecked(int employeeId, bool isChecked)
    {
        if (isChecked) selectedHourlyIds.Add(employeeId);
        else selectedHourlyIds.Remove(employeeId);
    }

    private void ToggleAllHourlyChecked(ChangeEventArgs e)
    {
        var checkAll = (bool)(e.Value ?? false);
        if (checkAll)
            foreach (var emp in FilteredSummaries) selectedHourlyIds.Add(emp.EmployeeId);
        else
            foreach (var emp in FilteredSummaries.ToList()) selectedHourlyIds.Remove(emp.EmployeeId);
    }
    // Substitutes roll up to their own payroll grain (per-period, not per-hour).
    // Loaded at page level so the status bar can show hourly hours + sub periods
    // side-by-side in a single header, matching HR's payroll workflow.
    private List<SubstitutePayrollSummary> subPayrollSummaries = new();

    // Pay-period dropdown (replaced prev/next buttons 2026-04-24).
    private List<PayPeriodInfo> availablePeriods = new();
    private int selectedPayPeriodId = 0;

    private string filterStatus = "all";
    private bool payPeriodExported = false;
    private DateTime? exportedDate;
    private string? exportedBy;

    // Phase 4: Hourly / Substitutes tab switcher.
    private string activeTab = "hourly";

    private void SetTab(string tab)
    {
        if (tab != "hourly" && tab != "substitutes") return;
        activeTab = tab;
    }

    private bool allHRApproved => payrollSummaries.Count > 0 && payrollSummaries.All(p => p.HRApproved);

    private IEnumerable<PayrollSummary> FilteredSummaries => filterStatus switch
    {
        "pending_hr" => payrollSummaries.Where(p => p.SupervisorApproved && !p.HRApproved),
        "approved" => payrollSummaries.Where(p => p.HRApproved),
        _ => payrollSummaries
    };

    protected override async Task OnInitializedAsync()
    {
        periodOffset = PeriodOffset;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserEmail = authState.User.FindFirst("preferred_username")?.Value ?? "";

        // Populate the pay-period dropdown. Seed the selection from the URL
        // PeriodOffset (legacy /hr/payroll/{offset}) if provided, else default
        // to today's open period.
        availablePeriods = await PayPeriodService.GetRecentPayPeriodsAsync();
        var initialAnchor = DateTime.Today.AddDays(periodOffset * 14);
        var initialPeriod = await PayPeriodService.GetPayPeriodForDateAsync(initialAnchor);
        selectedPayPeriodId = availablePeriods.Any(p => p.PayPeriodId == initialPeriod.PayPeriodId)
            ? initialPeriod.PayPeriodId
            : availablePeriods.FirstOrDefault(p => p.IsOpen)?.PayPeriodId ?? availablePeriods.FirstOrDefault()?.PayPeriodId ?? 0;

        await LoadPayrollData();
    }

    private async Task OnPayPeriodChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) return;
        selectedPayPeriodId = id;
        await LoadPayrollData();
    }

    private async Task LoadPayrollData()
    {
        isLoading = true;
        try
        {
            // Resolve the period from the dropdown selection. Fall back to
            // today's period if the selection isn't in the list for any reason.
            currentPayPeriod = availablePeriods.FirstOrDefault(p => p.PayPeriodId == selectedPayPeriodId)
                ?? await PayPeriodService.GetCurrentPayPeriodAsync();
            payrollSummaries = await TimesheetService.GetPayrollSummariesAsync(currentPayPeriod.StartDate, currentPayPeriod.EndDate);
            subPayrollSummaries = await SubTimesheetService.GetPayrollSummariesAsync(currentPayPeriod.StartDate, currentPayPeriod.EndDate);

            using var context = await DbFactory.CreateDbContextAsync();
            var pp = await context.TcPayPeriods.FirstOrDefaultAsync(p => p.StartDate == currentPayPeriod.StartDate && p.EndDate == currentPayPeriod.EndDate);
            payPeriodExported = pp?.ExportedDate != null;
            exportedDate = pp?.ExportedDate;
            exportedBy = pp?.ExportedBy;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading payroll"); }
        finally { isLoading = false; StateHasChanged(); }
    }

    // PreviousPeriod / NextPeriod removed 2026-04-24 in favor of the pay-period
    // dropdown. OnPayPeriodChangedAsync is the single entry point for nav.
    private void ViewDetails(int id) => Navigation.NavigateTo($"/supervisor/timesheet/{id}/{periodOffset}");

    // Deep-link to the Exceptions section on the single-employee review page.
    // Matches the id="exceptions" anchor on SupervisorTimesheetView so the
    // browser scrolls straight to the exceptions list after nav.
    private void ViewExceptions(int id) => Navigation.NavigateTo($"/supervisor/timesheet/{id}/{periodOffset}#exceptions");

    private async Task ApproveEmployee(int employeeId)
    {
        if (currentPayPeriod == null) return;
        await TimesheetService.ApproveTimesheetAsync(employeeId, currentPayPeriod.StartDate, currentPayPeriod.EndDate, currentUserEmail, "HR");
        await LoadPayrollData();
    }

    private async Task ApproveAllReady()
    {
        foreach (var emp in payrollSummaries.Where(p => p.SupervisorApproved && !p.HRApproved))
            await ApproveEmployee(emp.EmployeeId);
    }

    private async Task ExportToCSV()
    {
        if (!allHRApproved || currentPayPeriod == null) return;
        var csv = new StringBuilder();
        csv.AppendLine("EmployeeID,LastName,FirstName,PayPeriodStart,PayPeriodEnd,RegularHours,OvertimeHours,TotalHours,PayCode");
        foreach (var emp in payrollSummaries.Where(p => p.HRApproved))
        {
            var names = emp.EmployeeName.Split(' ', 2);
            var fn = names.Length > 0 ? names[0] : "";
            var ln = names.Length > 1 ? names[1] : "";
            if (emp.RegularHours > 0) csv.AppendLine($"{emp.AscenderEmployeeId ?? emp.IdNumber},{ln},{fn},{currentPayPeriod.StartDate:yyyy-MM-dd},{currentPayPeriod.EndDate:yyyy-MM-dd},{emp.RegularHours:F2},0.00,{emp.RegularHours:F2},REG");
            if (emp.OvertimeHours > 0) csv.AppendLine($"{emp.AscenderEmployeeId ?? emp.IdNumber},{ln},{fn},{currentPayPeriod.StartDate:yyyy-MM-dd},{currentPayPeriod.EndDate:yyyy-MM-dd},0.00,{emp.OvertimeHours:F2},{emp.OvertimeHours:F2},OT");
        }

        using var context = await DbFactory.CreateDbContextAsync();
        var pp = await context.TcPayPeriods.FirstOrDefaultAsync(p => p.StartDate == currentPayPeriod.StartDate)
                 ?? new TcPayPeriod { PeriodName = currentPayPeriod.PeriodName, StartDate = currentPayPeriod.StartDate, EndDate = currentPayPeriod.EndDate, PayDate = currentPayPeriod.PayDate };
        if (pp.PayPeriodId == 0) context.TcPayPeriods.Add(pp);
        pp.Status = PayPeriodStatus.Exported; pp.ExportedDate = DateTime.Now; pp.ExportedBy = currentUserEmail;
        await context.SaveChangesAsync();

        var fn2 = $"Payroll_{currentPayPeriod.StartDate:yyyyMMdd}.csv";

        // Audit: PAYROLL_EXPORTED. One row per export action with aggregate payroll figures
        // so compliance can reconstruct what was sent to CSS/Ascender without re-running the
        // query. Fires before the JS download prompt — order matters because the JS call
        // opens a file-save dialog and we want the audit row durable regardless of whether
        // the user saves or cancels the download.
        var exportedEmployees = payrollSummaries.Where(p => p.HRApproved).ToList();
        await Audit.LogActionAsync(
            actionCode: AuditActions.Payroll.Exported,
            entityType: AuditEntityTypes.PayPeriod,
            entityId: pp.PayPeriodId.ToString(),
            newValues: new
            {
                pp.PayPeriodId,
                pp.PeriodName,
                pp.StartDate,
                pp.EndDate,
                EmployeeCount = exportedEmployees.Count,
                TotalRegularHours = exportedEmployees.Sum(e => e.RegularHours),
                TotalOvertimeHours = exportedEmployees.Sum(e => e.OvertimeHours),
                TotalHours = exportedEmployees.Sum(e => e.RegularHours + e.OvertimeHours),
                FileName = fn2,
                ExportedBy = currentUserEmail
            },
            deltaSummary: $"Exported payroll for {pp.PeriodName} ({exportedEmployees.Count} employees, {exportedEmployees.Sum(e => e.RegularHours + e.OvertimeHours):F2}h total) as {fn2}",
            source: AuditSource.AdminUi);

        // Migration 060: archive the CSV bytes into TC_PayrollExport so HR can
        // recover the exact file later even after row edits.
        var csvBytes = Encoding.UTF8.GetBytes(csv.ToString());
        await ArchiveExportAsync(pp.PayPeriodId, fn2, csvBytes, null, exportedEmployees.Count,
            (decimal)exportedEmployees.Sum(e => e.RegularHours), (decimal)exportedEmployees.Sum(e => e.OvertimeHours));

        await JS.InvokeVoidAsync("downloadFile", fn2, Convert.ToBase64String(csvBytes));
        await LoadPayrollData();
    }

    /// <summary>
    /// 2026-04-27: combined paper-approve + PDF-export. For every checked
    /// hourly row, calls TimesheetService.MarkPaperApprovedAsync (which writes
    /// 3 distinct audit entries — Employee + Supervisor + HR — with Source =
    /// "PAPER"). Then generates a combined PDF via IPayrollPdfService and
    /// archives the bytes into TC_PayrollExport.PdfBlob for historical recovery.
    /// </summary>
    private async Task ApproveSelectedAndExportPdfAsync()
    {
        if (currentPayPeriod == null || selectedHourlyIds.Count == 0 || isApprovingExport) return;

        isApprovingExport = true;
        approveExportMsg = "";
        approveExportIsError = false;

        try
        {
            var ids = selectedHourlyIds.ToList();
            int approved = 0, skipped = 0;
            foreach (var empId in ids)
            {
                try
                {
                    var did = await TimesheetService.MarkPaperApprovedAsync(
                        empId, currentPayPeriod.StartDate, currentPayPeriod.EndDate, currentUserEmail);
                    if (did) approved++; else skipped++;
                }
                catch (Exception inner)
                {
                    Logger.LogWarning(inner, "Paper-approve failed for employee {Id}", empId);
                    skipped++;
                }
            }

            // Generate combined PDF (subs not selected from this tab — passed empty list).
            var pdfBytes = await PayrollPdf.GenerateCombinedPdfAsync(
                currentPayPeriod.StartDate,
                currentPayPeriod.EndDate,
                ids,
                Array.Empty<int>(),
                currentUserEmail);

            // Archive PDF blob.
            using var ctx = await DbFactory.CreateDbContextAsync();
            var pp = await ctx.TcPayPeriods
                .FirstOrDefaultAsync(p => p.StartDate == currentPayPeriod.StartDate && p.EndDate == currentPayPeriod.EndDate);
            if (pp != null)
            {
                await ArchiveExportAsync(pp.PayPeriodId,
                    $"Payroll_{currentPayPeriod.StartDate:yyyyMMdd}.pdf",
                    null, pdfBytes,
                    ids.Count,
                    payrollSummaries.Where(p => ids.Contains(p.EmployeeId)).Sum(p => p.RegularHours),
                    payrollSummaries.Where(p => ids.Contains(p.EmployeeId)).Sum(p => p.OvertimeHours));
            }

            await Audit.LogActionAsync(
                actionCode: AuditActions.Payroll.PdfExported,
                entityType: AuditEntityTypes.PayPeriod,
                entityId: pp?.PayPeriodId.ToString() ?? "0",
                newValues: new
                {
                    PayPeriodId = pp?.PayPeriodId,
                    EmployeeIds = ids,
                    Approved = approved,
                    Skipped = skipped,
                    Bytes = pdfBytes.Length,
                    ExportedBy = currentUserEmail
                },
                deltaSummary: $"Combined PDF export — {ids.Count} employees ({approved} paper-approved, {skipped} already-approved/skipped) by {currentUserEmail}",
                source: AuditSource.AdminUi);

            // Push to the browser.
            var fileName = $"Payroll_{currentPayPeriod.StartDate:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(pdfBytes));

            approveExportMsg = $"Paper-approved {approved} row(s) ({skipped} skipped) and downloaded combined PDF.";
            await LoadPayrollData();
            selectedHourlyIds.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ApproveSelectedAndExportPdf failed");
            approveExportMsg = "Failed: " + ex.Message;
            approveExportIsError = true;
        }
        finally
        {
            isApprovingExport = false;
        }
    }

    /// <summary>
    /// Archive an export's bytes into TC_PayrollExport (migration 060).
    /// CsvBlob and PdfBlob may be null individually; at least one should be
    /// non-null. Logs PAYROLL_EXPORT_ARCHIVED on success.
    /// </summary>
    private async Task ArchiveExportAsync(
        int payPeriodId, string fileName,
        byte[]? csvBytes, byte[]? pdfBytes,
        int recordCount, decimal totalRegular, decimal totalOt)
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        var export = new TcPayrollExport
        {
            PayPeriodId    = payPeriodId,
            ExportFormat   = pdfBytes != null && csvBytes == null ? "PDF"
                            : csvBytes != null && pdfBytes == null ? "CSV"
                            : "BUNDLE",
            ExportMethod   = "DOWNLOAD",
            FileName       = fileName,
            RecordCount    = recordCount,
            TotalRegularHours = totalRegular,
            TotalOvertimeHours = totalOt,
            Status         = ExportStatus.Generated,
            ExportedBy     = currentUserEmail,
            ExportDate     = DateTime.Now,
            CsvBlob        = csvBytes,
            PdfBlob        = pdfBytes
        };
        ctx.TcPayrollExports.Add(export);
        await ctx.SaveChangesAsync();

        await Audit.LogActionAsync(
            actionCode: AuditActions.Payroll.ExportArchived,
            entityType: AuditEntityTypes.PayPeriod,
            entityId: payPeriodId.ToString(),
            newValues: new
            {
                ExportId = export.ExportId,
                payPeriodId,
                fileName,
                Format = export.ExportFormat,
                CsvBytes = csvBytes?.Length,
                PdfBytes = pdfBytes?.Length,
                ExportedBy = currentUserEmail
            },
            deltaSummary: $"Archived {export.ExportFormat} export {fileName} ({(csvBytes?.Length ?? 0) + (pdfBytes?.Length ?? 0)} bytes) for pay period {payPeriodId} by {currentUserEmail}",
            source: AuditSource.AdminUi);
    }
}
