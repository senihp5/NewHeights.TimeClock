@page "/kiosk/tablet/{TerminalCode}"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout KioskLayout
@using NewHeights.TimeClock.Data
@using NewHeights.TimeClock.Data.Entities
@using NewHeights.TimeClock.Shared.Constants
@using NewHeights.TimeClock.Shared.DTOs
@using NewHeights.TimeClock.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IKioskScanService KioskScanService
@inject IDbContextFactory<TimeClockDbContext> DbFactory
@inject IJSRuntime JS
@inject ILogger<KioskTablet> Logger
@implements IAsyncDisposable

<PageTitle>Check-In Kiosk — @AppConstants.Branding.ShortName</PageTitle>

@* 2026-07-08: PWA manifest tells the browser (and any "Add to Home
   screen" flow, including Managed Google Play's Web App installer)
   that this route is landscape-only + fullscreen. Belt-and-suspenders
   with the Intune-side Web App orientation setting; also gives
   screen.orientation.lock('landscape') a valid preferred orientation
   to lock to on Chromium builds that reject the lock otherwise. *@
<HeadContent>
    <link rel="manifest" href="/kiosk-tablet.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="screen-orientation" content="landscape" />
    <meta name="x5-orientation" content="landscape" />
</HeadContent>

@* 2026-07-08 Phase 2c v2: full-viewport landscape layout, no top
   header. Right column stacks Logo → School name → Time → Ready-to-
   scan/Result. Camera panel is ~65% of the width so scanning has
   plenty of real estate. Body-level tap requests fullscreen (some
   Chromium contexts require a user gesture to enter fullscreen). *@
<div class="tk-fullpage" @onclick="RequestFullscreenAsync">
    @if (!terminalResolved)
    {
        <div class="tk-offline-card">
            <img src="/images/phoenix.png" alt="Phoenix" class="tk-offline-icon" />
            <h2>Terminal offline</h2>
            <p>This kiosk is not registered or has been deactivated. Please contact IT.</p>
            <p class="tk-offline-code">Terminal code: <code>@TerminalCode</code></p>
        </div>
    }
    else if (!isKioskOpen)
    {
        @* 2026-07-08 (option A): Kiosk closed outside school hours.
           Camera + decode NOT started while this branch renders. The
           clock timer re-evaluates every second; the moment we hit
           an open window the branch flips and OnAfterRenderAsync
           starts the scanner. No reboot required. *@
        <div class="tk-closed-fullscreen">
            <img src="/images/logo.jpg" alt="New Heights" class="tk-closed-logo" />
            <h1 class="tk-closed-school">@AppConstants.Branding.SchoolName</h1>
            <div class="tk-closed-clock">@currentTime.ToString("h:mm:ss tt")</div>
            <div class="tk-closed-card">
                <img src="/images/phoenix.png" alt="Phoenix" class="tk-closed-icon" />
                <h2>Kiosk closed</h2>
                <p>Check-in is unavailable outside of school hours.</p>
                <p class="tk-reopens">Reopens <strong>@AppConstants.Kiosk.OperatingSchedule.FormatReopens(currentTime, nextOpenAt)</strong></p>
            </div>
            @if (terminal != null)
            {
                <div class="tk-closed-footer">@FormatTerminalFooter(terminal)</div>
            }
        </div>
    }
    else
    {
        <div class="tk-cam-panel">
            <video @ref="videoRef" class="tk-video" autoplay muted playsinline></video>
            @if (terminal?.PhotoCaptureEnabled == true)
            {
                <video @ref="photoVideoRef" class="tk-photo-video" autoplay muted playsinline></video>
            }
            <div class="tk-cam-corner-label">
                <img src="/images/phoenix.png" alt="Phoenix" class="tk-corner-icon" />
                <span>Hold badge up to BACK camera on the left</span>
            </div>
        </div>
        <div class="tk-right-panel">
            <div class="tk-right-header">
                <img src="/images/logo.jpg" alt="New Heights" class="tk-header-logo" />
                <h1 class="tk-header-school">@AppConstants.Branding.SchoolName</h1>
                <p class="tk-header-time">@currentTime.ToString("h:mm:ss tt")</p>
                <p class="tk-header-date">@currentTime.ToString("dddd, MMMM d, yyyy")</p>
            </div>
            <div class="tk-right-content">
                @if (showResult)
                {
                    <KioskScanCard
                        PhotoBase64="@photoBase64"
                        Initial="@GetInitial()"
                        ResultMessage="@resultMessage"
                        ResultClass="@(isSuccess ? "success" : (isInfoResult ? "info" : "error"))"
                        PersonName="@personName"
                        ScanTypeDisplay="@scanTypeDisplay"
                        ScanTypeBadgeClass="@scanTypeBadgeClass"
                        PersonTypeDisplay="@personTypeDisplay"
                        TotalHoursToday="@totalHoursToday" />
                }
                else
                {
                    <div class="tk-idle-hint">
                        <img src="/images/phoenix.png" alt="Phoenix" class="tk-idle-icon" />
                        <h2>Ready to scan</h2>
                        <p class="tk-idle-location">@terminal?.LocationDescription</p>
                        <p class="tk-idle-sub">Hold your ID badge up to the <strong>BACK camera</strong> on the left.</p>
                    </div>
                }
            </div>
            <div class="tk-right-footer">
                @if (terminal != null)
                {
                    <span>@FormatTerminalFooter(terminal)</span>
                }
            </div>
        </div>
    }
</div>

<style>
    /* 2026-07-08: Phase 2 tablet-kiosk page styles. Uses the same
       .kiosk-container / .kiosk-header / .scan-area / .kiosk-footer
       shell as ClockInOut.razor (defined in wwwroot/css/kiosk.css).
       Everything specific to tablet-scanner display and offline
       state uses the tk- prefix. */

    /* 2026-07-08 Phase 2c v3: full-viewport landscape.
       .tk-fullpage fills the browser viewport exactly (100vw / 100vh),
       eliminating scrollbars. Camera panel shrunk to 50% (was 65%) —
       QR scans reliably at this size on the Pritom P7 rear camera and
       the right panel gets more room so KioskScanCard doesn't
       overflow. Right panel bumped to 50% (was 35%). */
    html, body { margin: 0; padding: 0; overflow: hidden; }

    .tk-fullpage {
        display: flex;
        flex-direction: row;
        width: 100vw;
        height: 100vh;
        max-width: 100vw;
        max-height: 100vh;
        background: #0f172a;
        overflow: hidden;
        box-sizing: border-box;
        gap: 0;
    }

    /* ── Left: camera (50%) ─────────────────────────────────────── */
    .tk-cam-panel {
        flex: 0 0 50%;
        position: relative;
        background: #000;
        overflow: hidden;
    }
    .tk-video {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
        object-fit: cover;
    }
    .tk-photo-video {
        position: absolute; width: 1px; height: 1px;
        opacity: 0; pointer-events: none;
    }
    .tk-cam-corner-label {
        position: absolute;
        top: 12px; left: 12px;
        display: flex; align-items: center; gap: 0.5rem;
        /* 2026-07-08 fix: dropped backdrop-filter: blur(4px). GPU-heavy
           on Pritom P7, was starving the camera compositor. Solid dark
           background achieves the same readability without the cost. */
        background: rgba(15, 23, 42, 0.85); color: white;
        padding: 0.5rem 0.85rem; border-radius: 8px;
        font-size: 0.95rem; font-weight: 600;
        letter-spacing: 0.02em;
        z-index: 2;
    }

    /* 2026-07-08 v2: Snapshot flash animation. Triggered by
       tabletScanner.flashCameraPanel() after a successful decode.
       CRITICAL: base rule sets opacity: 0 explicitly. Without that,
       once the 400ms animation finishes the ::after reverts to
       opacity 1 (browser default) and the white sheet stays over
       the camera forever. animation-fill-mode: forwards belt-and-
       suspenders the 100% keyframe as the resting state. */
    .tk-cam-panel.tk-flash::after {
        content: '';
        position: absolute; inset: 0;
        background: white;
        opacity: 0;
        pointer-events: none;
        animation: tkSnapshotFlash 400ms ease-out forwards;
        z-index: 3;
    }
    @@keyframes tkSnapshotFlash {
        0%   { opacity: 0; }
        15%  { opacity: 0.85; }
        100% { opacity: 0; }
    }
    .tk-corner-icon { width: 24px; height: 24px; opacity: 0.95; }

    /* ── Right: header + content + footer (50%) ─────────────────── */
    .tk-right-panel {
        flex: 0 0 50%;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
        color: #1e3a5f;
        overflow: hidden;
    }

    .tk-right-header {
        background: #1e3a5f;
        color: white;
        padding: 0.85rem 1rem 1rem;
        text-align: center;
        flex-shrink: 0;
    }
    .tk-header-logo {
        display: block;
        margin: 0 auto 0.35rem;
        height: 44px;
        width: auto;
        border-radius: 4px;
    }
    .tk-header-school {
        margin: 0.2rem 0 0.15rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: white;
        letter-spacing: 0.02em;
        line-height: 1.2;
    }
    .tk-header-time {
        margin: 0.15rem 0 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #f5b81c;
        font-variant-numeric: tabular-nums;
    }
    .tk-header-date {
        margin: 0.1rem 0 0;
        font-size: 0.78rem;
        color: #e2e8f0;
    }

    .tk-right-content {
        flex: 1 1 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.75rem;
        overflow: hidden;
        min-width: 0;
    }

    /* 2026-07-08 v3: KioskScanCard was designed for the reception
       kiosk (full-viewport width). Constrain it here so it fits
       inside the tablet's right panel without horizontal overflow.
       Scoped to .tk-right-content so ClockInOut.razor is untouched.
       Inline style block = global CSS (not scoped), so plain
       descendant selectors work — no ::deep needed. */
    .tk-right-content .result-display {
        max-width: 100%;
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.5rem;
    }
    .tk-right-content .employee-photo {
        width: 120px;
        height: 120px;
        max-width: 40%;
        object-fit: cover;
        border-radius: 50%;
        margin: 0 auto;
    }
    .tk-right-content .employee-photo.placeholder {
        display: flex; align-items: center; justify-content: center;
        background: #1e3a5f; color: white;
        font-size: 3rem; font-weight: 700;
    }
    .tk-right-content .result-message {
        width: 100%;
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .tk-right-content .result-message h3 {
        font-size: 1.25rem;
        margin: 0.25rem 0;
        line-height: 1.25;
    }
    .tk-right-content .employee-name {
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0.15rem 0;
    }
    .tk-right-content .punch-type-badge {
        display: inline-block;
        margin: 0.25rem 0;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }
    .tk-right-content .person-type,
    .tk-right-content .hours-today {
        font-size: 0.85rem;
        margin: 0.15rem 0;
    }

    /* 2026-07-08: "info" state for the KioskScanCard — used for the
       60s per-person debounce ("Already scanned, please wait Xs")
       so users don't read it as a red error. Yellow-tinted, not
       alarming. Style overrides only apply inside .tk-right-content
       so ClockInOut's error styling is untouched. */
    .tk-right-content .result-display.info {
        background: #fef9c3;   /* soft amber */
        color: #78350f;
        border: 1px solid #fde68a;
        border-radius: 8px;
    }
    .tk-right-content .result-display.info h3 { color: #78350f; }

    .tk-right-footer {
        flex-shrink: 0;
        padding: 0.5rem 1rem 0.75rem;
        font-size: 0.75rem;
        color: #64748b;
        text-align: center;
        border-top: 1px solid #e2e8f0;
        line-height: 1.3;
    }

    /* ── Idle prompt ─────────────────────────────────────────────── */
    .tk-idle-hint { text-align: center; max-width: 100%; }
    .tk-idle-icon {
        width: 84px; height: 84px; opacity: 0.75;
        margin-bottom: 0.5rem;
    }
    .tk-idle-hint h2 {
        font-size: 1.75rem;
        margin: 0.25rem 0;
        color: #1e3a5f;
        font-weight: 700;
    }
    .tk-idle-location {
        font-size: 1rem;
        color: #b45309;
        font-weight: 700;
        margin: 0.25rem 0 0.5rem;
    }
    .tk-idle-sub {
        font-size: 0.88rem;
        color: #475569;
        line-height: 1.4;
        margin: 0;
    }

    /* ── Portrait fallback for desktop testing ──────────────────── */
    @@media (max-width: 768px) {
        .tk-fullpage { flex-direction: column; }
        .tk-cam-panel { flex: 0 0 55%; }
        .tk-right-panel { flex: 0 0 45%; }
    }

    /* 2026-07-08 option A: full-viewport "kiosk closed" screen. Fills
       100vw / 100vh (matches the .tk-fullpage flex parent) so it takes
       over the whole tablet during off-hours. Camera panel is NOT
       mounted in this branch — no getUserMedia stream running. */
    .tk-closed-fullscreen {
        width: 100vw; height: 100vh;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
        color: white; text-align: center; padding: 2rem;
        box-sizing: border-box;
    }
    .tk-closed-logo { height: 72px; width: auto; border-radius: 8px;
        margin-bottom: 0.75rem; opacity: 0.95; }
    .tk-closed-school { font-size: 1.5rem; font-weight: 700; margin: 0.25rem 0 0.75rem;
        color: white; }
    .tk-closed-clock { font-size: 3rem; font-weight: 700; color: #f5b81c;
        font-variant-numeric: tabular-nums; margin-bottom: 1.5rem; }
    .tk-closed-card { max-width: 480px; background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.2); border-radius: 12px;
        padding: 1.5rem 2rem;
        /* 2026-07-08 fix: dropped backdrop-filter blur — same reason as
           .tk-cam-corner-label. Solid semi-transparent bg reads fine. */ }
    .tk-closed-icon { width: 72px; height: 72px; opacity: 0.85;
        margin-bottom: 0.5rem; }
    .tk-closed-card h2 { color: #f5b81c; margin: 0.5rem 0 0.75rem;
        font-size: 1.75rem; }
    .tk-closed-card p { color: #e2e8f0; margin: 0.35rem 0; font-size: 1rem;
        line-height: 1.4; }
    .tk-reopens { margin-top: 0.75rem !important; font-size: 1.1rem !important; }
    .tk-reopens strong { color: white; }
    .tk-closed-footer { position: absolute; bottom: 1rem; font-size: 0.75rem;
        color: rgba(255,255,255,0.5); }

    .tk-offline-card { max-width: 480px; margin: 4rem auto;
        background: white; border: 2px solid #b91c1c; border-radius: 12px;
        padding: 2rem; text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
    .tk-offline-card h2 { color: #b91c1c; margin: 0.75rem 0 0.5rem; }
    .tk-offline-card p { color: #374151; margin: 0.25rem 0; }
    .tk-offline-icon { width: 72px; height: 72px; opacity: 0.6; }
    .tk-offline-code { margin-top: 1rem !important; font-size: 0.85rem;
        color: #6b7280; }
    .tk-offline-code code { background: #f3f4f6; padding: 2px 8px;
        border-radius: 4px; font-family: monospace; }
</style>

@code {
    // ── Route parameter ────────────────────────────────────────────────
    [Parameter] public string TerminalCode { get; set; } = "";

    // ── Resolved terminal (null until OnInitializedAsync completes) ────
    private TcTerminal? terminal;
    private bool terminalResolved = false;

    // ── UI display state — mirrors ClockInOut for KioskScanCard ────────
    private bool showResult = false;
    private bool isSuccess = false;
    private string resultMessage = "";
    private string personName = "";
    private string photoBase64 = "";
    private decimal? totalHoursToday = null;
    private string scanTypeDisplay = "";
    private string scanTypeBadgeClass = "in";
    private string personTypeDisplay = "";

    // ── Clock display ──────────────────────────────────────────────────
    private DateTime currentTime = DateTime.Now;
    private System.Timers.Timer? clockTimer;

    // ── Operating-hours state (option A, 2026-07-08) ──────────────────
    // Recomputed every clock tick from AppConstants.Kiosk.OperatingSchedule.
    // isKioskOpen drives the razor branch; nextOpenAt drives the "reopens
    // at X" line on the closed card.
    private bool isKioskOpen = true;
    private DateTime nextOpenAt = DateTime.Now;

    // ── Scan debounce + auto-reset ─────────────────────────────────────
    private DateTime lastScanTime = DateTime.MinValue;
    private CancellationTokenSource? autoResetCts;

    // ── JS refs + interop ──────────────────────────────────────────────
    private ElementReference videoRef;
    private ElementReference photoVideoRef;
    private DotNetObjectReference<KioskTablet>? dotNetRef;
    private bool scannerStarted = false;

    protected override async Task OnInitializedAsync()
    {
        // Resolve terminal server-side. Restricted to TABLET_KIOSK so an
        // ESP32 code accidentally pasted into a tablet URL doesn't succeed.
        terminal = await KioskScanService.ResolveActiveTerminalAsync(
            TerminalCode,
            AppConstants.Kiosk.DeviceType.TabletKiosk);
        terminalResolved = terminal != null;

        if (!terminalResolved)
        {
            Logger.LogWarning(
                "KioskTablet: unresolvable or inactive terminal code {Code}",
                TerminalCode);
        }

        // Initial schedule check — controls whether the scanner is
        // started at all in OnAfterRenderAsync.
        isKioskOpen = AppConstants.Kiosk.OperatingSchedule.IsOpen(DateTime.Now);
        nextOpenAt = AppConstants.Kiosk.OperatingSchedule.NextOpenAt(DateTime.Now);

        // Clock ticks every second on the server for the header display.
        // Same tick also drives the option-A open/closed transition — if
        // the schedule flips, we start or stop the JS scanner without
        // needing a reboot.
        clockTimer = new System.Timers.Timer(1000);
        clockTimer.Elapsed += async (_, _) =>
        {
            currentTime = DateTime.Now;

            var shouldBeOpen = AppConstants.Kiosk.OperatingSchedule.IsOpen(currentTime);
            var flipped = shouldBeOpen != isKioskOpen;
            isKioskOpen = shouldBeOpen;
            if (!isKioskOpen)
            {
                nextOpenAt = AppConstants.Kiosk.OperatingSchedule.NextOpenAt(currentTime);
            }

            try { await InvokeAsync(StateHasChanged); } catch { }

            // Handle scanner start/stop on state flip. On flip to closed we
            // stop the JS scanner immediately so the camera powers down;
            // the razor branch will hide the <video> element on the next
            // render. On flip to open, the re-render mounts <video> and
            // OnAfterRenderAsync starts the scanner.
            if (flipped && !isKioskOpen && scannerStarted)
            {
                try { await JS.InvokeVoidAsync("tabletScanner.stop"); }
                catch (Exception ex) { Logger.LogWarning(ex, "KioskTablet: scanner stop on close failed"); }
                scannerStarted = false;
                Logger.LogInformation("KioskTablet: entered off-hours — scanner stopped");
            }
        };
        clockTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Start the JS scanner when: terminal validated + kiosk currently
        // open + scanner not already running. On first render this covers
        // normal boot; on subsequent renders it covers the option-A
        // transition from off-hours (video element wasn't mounted) into
        // open hours (video element just got mounted, needs scanner).
        // Skip on the offline card render path and while closed.
        if (!terminalResolved || !isKioskOpen || scannerStarted) return;

        try
        {
            dotNetRef = DotNetObjectReference.Create(this);
            var photoEnabled = terminal?.PhotoCaptureEnabled == true;
            await JS.InvokeVoidAsync(
                "tabletScanner.start",
                videoRef,
                dotNetRef,
                photoEnabled,
                photoEnabled ? photoVideoRef : (ElementReference?)null);
            scannerStarted = true;

            // 2026-07-08 Phase 2c: request fullscreen, lock orientation
            // to landscape, and acquire a Wake Lock so the screen doesn't
            // sleep even if Intune's Power Settings policy isn't honored
            // by the tablet's OEM (off-brand Pritom P7 aggressively
            // sleeps on the 1-minute default). All three fail silently
            // on browsers that don't support them.
            try { await JS.InvokeVoidAsync("tabletScanner.enterKioskDisplayMode"); }
            catch (Exception ex) { Logger.LogWarning(ex, "KioskTablet: display-mode helpers failed"); }

            // 2026-07-08 thermal tuning D: idle-dim overlay. Installs
            // document-level listeners once; overlay applies after 3 min
            // of no touch / scan and clears on any activity. Camera keeps
            // running underneath so a scan wakes it instantly.
            try
            {
                await JS.InvokeVoidAsync("tabletScanner.installIdleWatch");
                await JS.InvokeVoidAsync("tabletScanner.armIdleDimTimer");
            }
            catch (Exception ex) { Logger.LogWarning(ex, "KioskTablet: idle-dim install failed"); }

            // Stamp LastSeenAt + user-agent once at boot so /admin/kiosks
            // shows the tablet is alive even before the first badge scan.
            await UpdateLastSeenAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "KioskTablet: failed to start scanner for terminal {Id}",
                terminal?.TerminalId);
        }
    }

    /// <summary>
    /// Called from tablet-scanner.js when a QR is successfully decoded.
    /// Reuses the same KioskScanService path the reception kiosk uses;
    /// the only kiosk-side difference is that the raw payload arrived
    /// via camera instead of a hidden text input, and we can attach an
    /// optional photo snapshot when PhotoCaptureEnabled = true.
    /// </summary>
    [JSInvokable]
    public async Task OnQrScanned(string payload, string? photoBase64Snapshot)
    {
        if (!terminalResolved || terminal == null) return;
        if (string.IsNullOrWhiteSpace(payload)) return;

        // 3-second debounce — matches ClockInOut behavior. Same scanned
        // badge fired twice in a burst only produces one punch.
        var now = DateTime.Now;
        if ((now - lastScanTime).TotalSeconds < 3)
        {
            Logger.LogInformation(
                "KioskTablet debounce: dropped duplicate scan {Delta:F1}s after last",
                (now - lastScanTime).TotalSeconds);
            return;
        }
        lastScanTime = now;

        autoResetCts?.Cancel();
        autoResetCts = new CancellationTokenSource();

        try
        {
            var result = await KioskScanService.ProcessRawScanAsync(
                payload.Trim(),
                terminal.CampusId,
                AppConstants.Kiosk.DeviceType.TabletKiosk,
                terminal.TerminalId,
                terminal.LocationId);

            ApplyScanResult(result);

            // Log the photoSnapshot presence but don't wire storage yet —
            // per build pack decision B (2026-06-30): plumbed but disabled.
            // If PhotoCaptureEnabled flips on later, this is the spot to
            // pipe photoBase64Snapshot into TC_TimePunches.ScanPhoto or
            // wherever the ESP32 firmware writes its captures.
            if (!string.IsNullOrEmpty(photoBase64Snapshot))
            {
                Logger.LogInformation(
                    "KioskTablet: photo snapshot received but storage disabled (terminal {Id})",
                    terminal.TerminalId);
            }

            await UpdateLastSeenAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "KioskTablet: scan handling failed for terminal {Id}",
                terminal.TerminalId);
            ShowError("System error — please try again");
        }

        _ = AutoResetAfterDelay(autoResetCts.Token);
    }

    private void ApplyScanResult(KioskScanResult result)
    {
        if (!result.Success)
        {
            // TOO_SOON is a friendly "you already scanned" hit, not a real
            // error — treat it as an info card (not red) so users don't
            // think their badge failed. Every other error stays red.
            var isInfo = string.Equals(result.ErrorCode, "TOO_SOON", StringComparison.Ordinal);
            ShowMessage(result.Message, isSuccess: false, isInfo: isInfo);
            return;
        }

        personName        = result.PersonName ?? "";
        photoBase64       = result.PhotoBase64 ?? "";
        totalHoursToday   = result.TotalHoursToday;
        scanTypeDisplay   = result.ScanTypeDisplay ?? "";
        scanTypeBadgeClass = result.ScanTypeBadgeClass ?? "in";
        personTypeDisplay = result.PersonTypeDisplay ?? "";
        resultMessage     = result.Message;
        isSuccess         = true;
        showResult        = true;
        StateHasChanged();

        // 2026-07-08: Snapshot flash on the camera panel so the user
        // sees an unmistakable visual confirmation even if they're
        // looking at their badge and not the screen. Fire-and-forget;
        // JS animation is entirely client-side.
        _ = JS.InvokeVoidAsync("tabletScanner.flashCameraPanel");
    }

    private void ShowError(string message) => ShowMessage(message, isSuccess: false, isInfo: false);

    /// <summary>
    /// Renders a non-success card. When isInfo=true, styles it as
    /// friendly info (yellow/blue) rather than an error (red) — used
    /// for the "you just scanned, please wait" debounce message so
    /// staff don't misread it as a scan failure.
    /// </summary>
    private void ShowMessage(string message, bool isSuccess, bool isInfo)
    {
        this.isSuccess    = isSuccess;
        this.isInfoResult = isInfo;
        resultMessage     = message;
        personName        = "";
        photoBase64       = "";
        scanTypeDisplay   = "";
        personTypeDisplay = "";
        totalHoursToday   = null;
        showResult        = true;
        StateHasChanged();
    }

    private bool isInfoResult = false;

    private async Task AutoResetAfterDelay(CancellationToken ct)
    {
        try
        {
            await Task.Delay(5000, ct);
            if (ct.IsCancellationRequested) return;
            showResult        = false;
            personName        = "";
            photoBase64       = "";
            totalHoursToday   = null;
            resultMessage     = "";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { /* expected on re-scan */ }
    }

    private string GetInitial()
    {
        if (string.IsNullOrWhiteSpace(personName)) return "?";
        return personName[0].ToString().ToUpper();
    }

    /// <summary>
    /// Tap-anywhere fullscreen. Some Chromium contexts (including
    /// Managed Google Play web apps when Chrome UI is showing) refuse
    /// to enter fullscreen automatically at load — a user gesture is
    /// required. Tapping the page anywhere satisfies that gesture and
    /// hides the Chrome address bar / navigation.
    /// </summary>
    private async Task RequestFullscreenAsync()
    {
        try { await JS.InvokeVoidAsync("tabletScanner.enterKioskDisplayMode"); }
        catch { /* silent — already in fullscreen or unsupported */ }
    }

    private static string FormatTerminalFooter(TcTerminal t)
    {
        var campus = t.Campus?.CampusName ?? $"Campus {t.CampusId}";
        return $"{campus} · {t.LocationDescription} · Terminal #{t.TerminalId}";
    }

    // Best-effort heartbeat write. Failures logged but never thrown —
    // scan-processing path must not depend on this succeeding.
    private async Task UpdateLastSeenAsync()
    {
        if (terminal == null) return;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var tracked = await context.TcTerminals
                .FirstOrDefaultAsync(t => t.TerminalId == terminal.TerminalId);
            if (tracked == null) return;
            tracked.LastSeenAt = DateTime.Now;
            // Firmware slot on a tablet = the browser user-agent, useful
            // to spot when a tablet gets factory-reset or its Edge is
            // updated. Truncated to 30 chars to fit the column width.
            var ua = await JS.InvokeAsync<string?>("tabletScanner.getUserAgent");
            if (!string.IsNullOrEmpty(ua))
            {
                tracked.LastSeenFirmware = ua.Length > 30 ? ua[..30] : ua;
            }
            await context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "KioskTablet: UpdateLastSeenAsync failed for terminal {Id}",
                terminal.TerminalId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        clockTimer?.Stop();
        clockTimer?.Dispose();
        autoResetCts?.Cancel();
        autoResetCts?.Dispose();

        if (scannerStarted)
        {
            try { await JS.InvokeVoidAsync("tabletScanner.stop"); }
            catch { /* JS may already be torn down */ }
        }
        dotNetRef?.Dispose();
    }
}
