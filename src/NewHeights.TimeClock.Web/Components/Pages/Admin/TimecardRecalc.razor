@page "/admin/timecard-recalc"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireHR")]
@using NewHeights.TimeClock.Data
@using NewHeights.TimeClock.Data.Entities
@using NewHeights.TimeClock.Shared.Audit
@using NewHeights.TimeClock.Shared.Constants
@using NewHeights.TimeClock.Shared.Enums
@using NewHeights.TimeClock.Web.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<TimeClockDbContext> DbFactory
@inject ITimesheetService TimesheetService
@inject IPayPeriodService PayPeriodService
@inject IAuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<TimecardRecalc> Logger

<PageTitle>Timecard Recalculation - @AppConstants.Branding.ShortName</PageTitle>

<div class="admin-page recalc-admin">
    <div class="admin-header">
        <div>
            <h1>Timecard Recalculation Tool</h1>
            <p class="admin-subtitle">
                Force daily-timecard hours to recompute from current active punches. Use after a bulk
                punch cleanup (void/repair operation) — the timesheet display reads stored
                <code>TC_DailyTimecards.TotalHours</code> so a recalc is required before the new
                numbers show up on <em>My Timesheet</em> or <em>Team Timesheets</em>.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">@errorMessage</div>
    }

    <!-- ── Section A: period-wide bulk recalc ───────────────────────────── -->
    <div class="admin-card wide">
        <h2>Period-wide bulk recalc</h2>
        <p class="section-help">
            Re-run <code>RecalculateDailyTimecardAsync</code> for every (employee, date) pair in
            a pay period that has at least one punch or existing daily timecard. Use as a
            safety pass before closing payroll, after a SQL-level cleanup, or whenever a CSV
            import may have failed silently per-date.
        </p>

        <div class="bulk-form">
            <div class="form-field">
                <label for="bulk-period">Pay Period</label>
                <select id="bulk-period" class="form-input"
                        @bind="bulkPayPeriodId"
                        disabled="@isWorking">
                    @foreach (var p in availablePeriods)
                    {
                        <option value="@p.PayPeriodId">
                            @p.PeriodName (@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy"))
                            @(p.IsOpen ? " · Current" : "")
                        </option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Scope</label>
                <div class="bulk-scope-row">
                    <label class="bulk-scope-radio">
                        <input type="radio" name="bulk-scope"
                               checked="@(bulkScope == "all-hourly")"
                               @onchange="SetScopeAllHourly"
                               disabled="@isWorking" />
                        <span>All hourly + part-time employees</span>
                    </label>
                    <label class="bulk-scope-radio">
                        <input type="radio" name="bulk-scope"
                               checked="@(bulkScope == "specific")"
                               @onchange="SetScopeSpecific"
                               disabled="@isWorking" />
                        <span>Specific employee</span>
                    </label>
                </div>
                @if (bulkScope == "specific")
                {
                    <select class="form-input bulk-emp-select" @bind="bulkEmployeeId" disabled="@isWorking">
                        <option value="0">— Select employee —</option>
                        @foreach (var emp in allEmployees)
                        {
                            <option value="@emp.EmployeeId">
                                @(emp.DisplayName ?? emp.Email) — @emp.IdNumber (#@emp.EmployeeId · @emp.EmployeeType)
                            </option>
                        }
                    </select>
                }
            </div>

            <div class="form-field form-field-action">
                <button class="btn-primary"
                        @onclick="RunBulkRecalcAsync"
                        disabled="@(isWorking || bulkPayPeriodId == 0 || (bulkScope == "specific" && bulkEmployeeId == 0))">
                    @(isWorking ? $"Recalcing… ({bulkProgressDone} of {bulkProgressTotal})" : "Run Bulk Recalc")
                </button>
            </div>
        </div>

        @if (bulkResults.Count > 0)
        {
            <div class="bulk-summary-strip">
                <span><strong>@bulkResults.Count</strong> total</span>
                <span class="divider">·</span>
                <span><strong>@bulkResults.Count(r => string.IsNullOrEmpty(r.Error))</strong> succeeded</span>
                @if (bulkResults.Any(r => !string.IsNullOrEmpty(r.Error)))
                {
                    <span class="divider">·</span>
                    <span class="warn-inline"><strong>@bulkResults.Count(r => !string.IsNullOrEmpty(r.Error))</strong> failed</span>
                }
                @if (bulkResults.Any(r => r.HoursBefore != r.HoursAfter))
                {
                    <span class="divider">·</span>
                    <span><strong>@bulkResults.Count(r => r.HoursBefore != r.HoursAfter)</strong> hours changed</span>
                }
            </div>

            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Work Date</th>
                            <th>Hours Before</th>
                            <th>Hours After</th>
                            <th>Δ</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in bulkResults)
                        {
                            var changed = row.HoursBefore != row.HoursAfter;
                            <tr class="@(changed ? "recalc-changed" : "")">
                                <td>@row.EmployeeDisplay <span class="muted-id">#@row.EmployeeId</span></td>
                                <td>@row.WorkDate.ToString("yyyy-MM-dd ddd")</td>
                                <td>@(row.HoursBefore?.ToString("F2") ?? "—")</td>
                                <td>
                                    @if (row.HoursAfter.HasValue)
                                    {
                                        <strong>@row.HoursAfter.Value.ToString("F2")</strong>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="@(changed ? "delta-changed" : "")">
                                    @if (changed && row.HoursBefore.HasValue && row.HoursAfter.HasValue)
                                    {
                                        var delta = row.HoursAfter.Value - row.HoursBefore.Value;
                                        var sign = delta >= 0 ? "+" : "";
                                        <strong>@sign@delta.ToString("F2")</strong>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.Error))
                                    {
                                        <span class="status-chip error" title="@row.Error">✗ Error</span>
                                    }
                                    else
                                    {
                                        <span class="status-chip success">✓ Recalced</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (!isWorking && bulkRanOnce)
        {
            <div class="empty-state">
                <p>No (employee, date) pairs with punches or daily timecards were found for that scope/period. Nothing to recalc.</p>
            </div>
        }
    </div>

    <!-- ── Section B: manual recalc ──────────────────────────────────────── -->
    <div class="admin-card wide">
        <h2>Manual recalc — specific employee + date range</h2>
        <p class="section-help">
            Recalculate one employee's daily timecards across a date range. Useful for individual
            fixes outside the cleanup batch.
        </p>

        <div class="manual-form">
            <div class="form-field">
                <label for="manual-employee">Employee</label>
                <select id="manual-employee" class="form-input" @bind="manualEmployeeId" disabled="@isWorking">
                    <option value="0">— Select employee —</option>
                    @foreach (var emp in allEmployees)
                    {
                        <option value="@emp.EmployeeId">
                            @emp.DisplayName — @emp.Email (#@emp.EmployeeId)
                        </option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label for="manual-start">Start Date</label>
                <input id="manual-start" type="date" class="form-input"
                       value="@manualStartDate.ToString("yyyy-MM-dd")"
                       @onchange="e => OnManualStartChanged(e.Value?.ToString())"
                       disabled="@isWorking" />
            </div>
            <div class="form-field">
                <label for="manual-end">End Date</label>
                <input id="manual-end" type="date" class="form-input"
                       value="@manualEndDate.ToString("yyyy-MM-dd")"
                       @onchange="e => OnManualEndChanged(e.Value?.ToString())"
                       disabled="@isWorking" />
            </div>
            <div class="form-field form-field-action">
                <button class="btn-primary"
                        @onclick="RunManualRecalcAsync"
                        disabled="@(isWorking || manualEmployeeId <= 0)">
                    @(isWorking ? "Recalculating…" : "Recalculate")
                </button>
            </div>
        </div>

        @if (manualResults.Count > 0)
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Work Date</th>
                            <th>Hours Before</th>
                            <th>Hours After</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in manualResults)
                        {
                            <tr>
                                <td>@r.WorkDate.ToString("yyyy-MM-dd ddd")</td>
                                <td>@(r.HoursBefore?.ToString("F2") ?? "—")</td>
                                <td>
                                    @if (r.HoursAfter.HasValue)
                                    {
                                        <strong>@r.HoursAfter.Value.ToString("F2")</strong>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.Error))
                                    {
                                        <span class="status-chip error" title="@r.Error">✗ Error</span>
                                    }
                                    else
                                    {
                                        <span class="status-chip success">✓ Recalced</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private bool isWorking = false;
    private string successMessage = "";
    private string errorMessage = "";
    private string currentUserEmail = "";

    private List<TcEmployee> allEmployees = new();

    // 2026-04-28 refactor: Section A is now a period-wide bulk recalc.
    private List<NewHeights.TimeClock.Web.Services.PayPeriodInfo> availablePeriods = new();
    private int bulkPayPeriodId = 0;
    private string bulkScope = "all-hourly";
    private int bulkEmployeeId = 0;
    private List<BulkResultRow> bulkResults = new();
    private int bulkProgressDone = 0;
    private int bulkProgressTotal = 0;
    private bool bulkRanOnce = false;

    // Manual recalc state (Section B — unchanged)
    private int manualEmployeeId = 0;
    private DateOnly manualStartDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-14));
    private DateOnly manualEndDate = DateOnly.FromDateTime(DateTime.Today);
    private List<ManualResultRow> manualResults = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserEmail = auth.User.Identity?.Name ?? "";
        await LoadEmployeesAsync();
        await LoadAvailablePeriodsAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        allEmployees = await ctx.TcEmployees
            .AsNoTracking()
            .Where(e => e.IsActive)
            .OrderBy(e => e.DisplayName)
            .ToListAsync();
    }

    /// <summary>
    /// Load 6 months of pay periods (back) + 2 months forward. Default selection
    /// is the current period — that's what HR usually wants to recalc before close.
    /// </summary>
    private async Task LoadAvailablePeriodsAsync()
    {
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            var current = await PayPeriodService.GetCurrentPayPeriodAsync();
            var anchor = current.StartDate;
            var rows = await ctx.TcPayPeriods
                .AsNoTracking()
                .Where(p => p.StartDate >= anchor.AddMonths(-6) && p.StartDate <= anchor.AddMonths(2))
                .OrderByDescending(p => p.StartDate)
                .ToListAsync();
            availablePeriods = rows.Select(p => new NewHeights.TimeClock.Web.Services.PayPeriodInfo
            {
                PayPeriodId = p.PayPeriodId,
                PeriodName = p.PeriodName,
                StartDate = p.StartDate,
                EndDate = p.EndDate,
                PayDate = p.PayDate ?? p.EndDate
            }).ToList();
            bulkPayPeriodId = current.PayPeriodId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pay periods for bulk recalc");
            errorMessage = "Could not load pay periods: " + ex.Message;
        }
    }

    private void SetScopeAllHourly()
    {
        bulkScope = "all-hourly";
        bulkEmployeeId = 0;
    }

    private void SetScopeSpecific()
    {
        bulkScope = "specific";
    }

    /// <summary>
    /// Section A — bulk recalc every (employee, date) pair in the selected pay
    /// period that has at least one TC_TimePunch or TC_DailyTimecard row.
    /// Hourly + part-time scope by default; can be narrowed to a specific
    /// employee. Audits a single bulk-action entry summarizing the run.
    /// </summary>
    private async Task RunBulkRecalcAsync()
    {
        if (isWorking || bulkPayPeriodId == 0) return;
        if (bulkScope == "specific" && bulkEmployeeId == 0)
        {
            errorMessage = "Pick a specific employee or switch to All Hourly scope.";
            return;
        }

        var period = availablePeriods.FirstOrDefault(p => p.PayPeriodId == bulkPayPeriodId);
        if (period == null) { errorMessage = "Pay period not found."; return; }

        isWorking = true;
        successMessage = "";
        errorMessage = "";
        bulkResults.Clear();
        bulkProgressDone = 0;
        bulkRanOnce = false;

        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();

            // Determine target employees.
            List<int> targetEmpIds;
            if (bulkScope == "specific")
            {
                targetEmpIds = new List<int> { bulkEmployeeId };
            }
            else
            {
                targetEmpIds = await ctx.TcEmployees
                    .AsNoTracking()
                    .Where(e => e.IsActive && (e.EmployeeType == EmployeeType.HourlyStaff
                                            || e.EmployeeType == EmployeeType.HourlyPartTime))
                    .Select(e => e.EmployeeId)
                    .ToListAsync();
            }

            if (targetEmpIds.Count == 0)
            {
                bulkRanOnce = true;
                return;
            }

            var startDt = period.StartDate.ToDateTime(TimeOnly.MinValue);
            var endDt = period.EndDate.ToDateTime(TimeOnly.MaxValue);

            // Find every (employee, date) with at least one punch in range.
            var fromPunches = await ctx.TcTimePunches
                .AsNoTracking()
                .Where(p => targetEmpIds.Contains(p.EmployeeId)
                         && p.PunchDateTime >= startDt
                         && p.PunchDateTime <= endDt)
                .Select(p => new { p.EmployeeId, p.PunchDateTime })
                .ToListAsync();

            var fromCards = await ctx.TcDailyTimecards
                .AsNoTracking()
                .Where(t => targetEmpIds.Contains(t.EmployeeId)
                         && t.WorkDate >= period.StartDate
                         && t.WorkDate <= period.EndDate)
                .Select(t => new { t.EmployeeId, t.WorkDate, t.TotalHours })
                .ToListAsync();

            // Deduplicate (employee, date) pairs.
            var pairKeySet = new HashSet<(int, DateOnly)>();
            foreach (var p in fromPunches) pairKeySet.Add((p.EmployeeId, DateOnly.FromDateTime(p.PunchDateTime)));
            foreach (var c in fromCards) pairKeySet.Add((c.EmployeeId, c.WorkDate));

            var orderedPairs = pairKeySet
                .OrderBy(k => k.Item1)
                .ThenBy(k => k.Item2)
                .ToList();
            bulkProgressTotal = orderedPairs.Count;

            if (bulkProgressTotal == 0)
            {
                bulkRanOnce = true;
                return;
            }

            // Lookup tables for display.
            var empLookup = allEmployees.ToDictionary(e => e.EmployeeId, e => e);
            var beforeLookup = fromCards
                .GroupBy(c => (c.EmployeeId, c.WorkDate))
                .ToDictionary(g => g.Key, g => (decimal?)g.First().TotalHours);

            // Run recalcs.
            int succeeded = 0, failed = 0;
            foreach (var (empId, workDate) in orderedPairs)
            {
                var row = new BulkResultRow
                {
                    EmployeeId = empId,
                    EmployeeDisplay = empLookup.TryGetValue(empId, out var e)
                        ? (e.DisplayName ?? e.Email ?? $"Employee {empId}")
                        : $"Employee {empId}",
                    WorkDate = workDate,
                    HoursBefore = beforeLookup.GetValueOrDefault((empId, workDate))
                };

                try
                {
                    await TimesheetService.RecalculateDailyTimecardAsync(empId, workDate);

                    using var freshCtx = await DbFactory.CreateDbContextAsync();
                    var fresh = await freshCtx.TcDailyTimecards
                        .AsNoTracking()
                        .FirstOrDefaultAsync(t => t.EmployeeId == empId && t.WorkDate == workDate);
                    row.HoursAfter = fresh?.TotalHours ?? 0m;
                    succeeded++;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Bulk recalc failed for {Emp} {Date}", empId, workDate);
                    row.Error = ex.Message;
                    failed++;
                }

                bulkResults.Add(row);
                bulkProgressDone++;
                if (bulkProgressDone % 5 == 0) StateHasChanged();
            }

            // Audit one summary entry per run.
            await Audit.LogActionAsync(
                actionCode: AuditActions.Timecard.Recalculated,
                entityType: AuditEntityTypes.PayPeriod,
                entityId: period.PayPeriodId.ToString(),
                newValues: new
                {
                    period.PayPeriodId,
                    period.PeriodName,
                    Scope = bulkScope,
                    SpecificEmployeeId = bulkScope == "specific" ? (int?)bulkEmployeeId : null,
                    EmployeesInScope = targetEmpIds.Count,
                    PairsRecalced = bulkProgressTotal,
                    Succeeded = succeeded,
                    Failed = failed,
                    HoursChanged = bulkResults.Count(r => r.HoursBefore != r.HoursAfter),
                    Source = "BULK_RECALC_PAGE",
                    RecalcedBy = currentUserEmail
                },
                deltaSummary: $"Period-wide bulk recalc on {period.PeriodName} — scope={bulkScope}, {succeeded} ok, {failed} failed, {bulkResults.Count(r => r.HoursBefore != r.HoursAfter)} changed hours",
                source: AuditSource.AdminUi);

            successMessage = $"Bulk recalc complete — {succeeded} of {bulkProgressTotal} succeeded"
                + (failed > 0 ? $", {failed} failed" : "")
                + ".";
            bulkRanOnce = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk recalc unexpected error");
            errorMessage = $"Bulk recalc failed: {ex.Message}";
        }
        finally
        {
            isWorking = false;
            StateHasChanged();
        }
    }

    // ── Manual section ────────────────────────────────────────────────────

    private void OnManualStartChanged(string? raw)
    {
        if (DateOnly.TryParse(raw, out var d)) manualStartDate = d;
    }

    private void OnManualEndChanged(string? raw)
    {
        if (DateOnly.TryParse(raw, out var d)) manualEndDate = d;
    }

    private async Task RunManualRecalcAsync()
    {
        if (manualEmployeeId <= 0) return;
        if (manualEndDate < manualStartDate)
        {
            errorMessage = "End date must be on or after start date.";
            return;
        }

        isWorking = true;
        errorMessage = "";
        successMessage = "";
        manualResults.Clear();

        try
        {
            // Build list of dates in range.
            var dates = new List<DateOnly>();
            for (var d = manualStartDate; d <= manualEndDate; d = d.AddDays(1))
                dates.Add(d);

            // Load "before" hours in a single query.
            using var ctx = await DbFactory.CreateDbContextAsync();
            var beforeRows = await ctx.TcDailyTimecards
                .AsNoTracking()
                .Where(t => t.EmployeeId == manualEmployeeId
                         && t.WorkDate >= manualStartDate
                         && t.WorkDate <= manualEndDate)
                .ToListAsync();

            foreach (var d in dates)
            {
                var before = beforeRows.FirstOrDefault(t => t.WorkDate == d)?.TotalHours;
                var row = new ManualResultRow { WorkDate = d, HoursBefore = before };
                try
                {
                    await TimesheetService.RecalculateDailyTimecardAsync(manualEmployeeId, d);

                    using var ctx2 = await DbFactory.CreateDbContextAsync();
                    var fresh = await ctx2.TcDailyTimecards
                        .AsNoTracking()
                        .FirstOrDefaultAsync(t => t.EmployeeId == manualEmployeeId && t.WorkDate == d);
                    row.HoursAfter = fresh?.TotalHours ?? 0m;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Manual recalc failed for Employee {Id} Date {Date}", manualEmployeeId, d);
                    row.Error = ex.Message;
                }
                manualResults.Add(row);
            }

            successMessage = $"Manual recalc complete — {manualResults.Count} date(s) processed.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Manual recalc failed: {ex.Message}";
        }
        finally
        {
            isWorking = false;
            StateHasChanged();
        }
    }

    // ── Row models ────────────────────────────────────────────────────────

    private class BulkResultRow
    {
        public int EmployeeId { get; set; }
        public string EmployeeDisplay { get; set; } = "";
        public DateOnly WorkDate { get; set; }
        public decimal? HoursBefore { get; set; }
        public decimal? HoursAfter { get; set; }
        public string? Error { get; set; }
    }

    private class ManualResultRow
    {
        public DateOnly WorkDate { get; set; }
        public decimal? HoursBefore { get; set; }
        public decimal? HoursAfter { get; set; }
        public string? Error { get; set; }
    }
}
