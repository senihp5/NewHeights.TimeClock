@page "/admin/timesheet-troubleshoot"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireAdmin")]
@using Microsoft.EntityFrameworkCore
@using NewHeights.TimeClock.Data
@using NewHeights.TimeClock.Data.Entities
@using NewHeights.TimeClock.Shared.Audit
@using NewHeights.TimeClock.Shared.Constants
@using NewHeights.TimeClock.Shared.Enums
@using NewHeights.TimeClock.Web.Services
@inject IDbContextFactory<TimeClockDbContext> DbFactory
@inject ITimesheetService TimesheetService
@inject ISubstituteTimesheetService SubTimesheetService
@inject IPayPeriodService PayPeriodService
@inject IAuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<AdminTimesheetTroubleshoot> Logger

<PageTitle>Timesheet Troubleshoot - @AppConstants.Branding.ShortName</PageTitle>

<div class="tt-page">
    <header class="tt-header">
        <h1>Timesheet Troubleshoot</h1>
        <p class="tt-subtitle">
            Diagnostic tool for individual hourly + substitute timesheets. Search any
            employee, see their raw punches / daily timecards / period summary / audit log,
            recalc a day, or open their timesheet in admin view to make corrections.
        </p>
    </header>

    @* Search bar *@
    <div class="tt-search-bar">
        <input type="search" class="tt-search-input"
               placeholder="Search employee by name, email, or ID number…"
               @bind="searchText"
               @bind:event="oninput"
               @onkeydown="OnSearchKeyDown" />
        <button class="tt-btn-search" @onclick="RunSearchAsync" disabled="@isSearching">
            @(isSearching ? "Searching…" : "Search")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(actionError))
    {
        <div class="tt-error" role="alert">@actionError</div>
    }

    @* Results list *@
    @if (searchResults.Count > 0 && selectedEmployee == null)
    {
        <div class="tt-results">
            <h3>@searchResults.Count match(es) — pick one</h3>
            <table class="tt-results-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Campus</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in searchResults)
                    {
                        <tr class="@(emp.IsActive ? "" : "inactive")">
                            <td><strong>@(emp.Staff?.FullName ?? emp.DisplayName ?? "—")</strong></td>
                            <td>@(emp.Email ?? "—")</td>
                            <td>@emp.IdNumber</td>
                            <td>@emp.EmployeeType</td>
                            <td>@(emp.HomeCampus?.CampusName ?? "—")</td>
                            <td>@(emp.IsActive ? "✓" : "✗")</td>
                            <td>
                                <button class="tt-btn-pick" @onclick="() => SelectEmployeeAsync(emp.EmployeeId)">Inspect</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Selected employee diagnostics *@
    @if (selectedEmployee != null)
    {
        <div class="tt-selected">
            <div class="tt-selected-header">
                <div>
                    <h2>@(selectedEmployee.Staff?.FullName ?? selectedEmployee.DisplayName ?? "—")</h2>
                    <p class="tt-meta">
                        @* EmployeeId is the DB primary key (what every query
                           filters on). IdNumber is the badge number shown to
                           humans on HR Payroll / Team Timesheets. They are
                           NOT the same thing — surfacing both prevents the
                           common confusion where a badge "104" gets mistaken
                           for "EmployeeId = 104". *@
                        EmployeeId: <code>@selectedEmployee.EmployeeId</code> ·
                        Badge IdNumber: <code>@selectedEmployee.IdNumber</code> ·
                        Email: <code>@(selectedEmployee.Email ?? "—")</code> ·
                        Type: <code>@selectedEmployee.EmployeeType</code> ·
                        Campus: <code>@(selectedEmployee.HomeCampus?.CampusName ?? "—")</code> ·
                        Active: <code>@selectedEmployee.IsActive</code>
                    </p>
                </div>
                <button class="tt-btn-back" @onclick="ClearSelection">← Back to results</button>
            </div>

            @* Pay-period picker — diagnostics are scoped to the selected period
               so admins can flip through periods one at a time instead of
               trying to make sense of a free-form date range that may straddle
               period boundaries (2026-04-28 refactor). *@
            <div class="tt-range">
                <label class="tt-pp-label">Pay Period:
                    <select @bind="selectedPayPeriodId"
                            @bind:after="LoadDiagnosticsAsync"
                            disabled="@isLoading">
                        @foreach (var p in availablePeriods)
                        {
                            <option value="@p.PayPeriodId">
                                @p.PeriodName (@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy"))
                                @(p.IsOpen ? " · Current" : "")
                            </option>
                        }
                    </select>
                </label>
                <button class="tt-btn-load" @onclick="LoadDiagnosticsAsync" disabled="@isLoading">
                    @(isLoading ? "Loading…" : "Reload")
                </button>

                @* Impersonation links — open the existing supervisor / admin review pages
                   for this employee. Those pages already allow full edit access for admins,
                   so the troubleshoot page hands off rather than re-implementing. Audit
                   trail captures admin's identity through those pages' existing handlers. *@
                <button class="tt-btn-impersonate" @onclick="OpenAsHourlyAsync"
                        disabled="@(!IsHourly(selectedEmployee))" title="Open Supervisor Timesheet view for this employee (admin can edit punches + approvals)">
                    Open as Hourly →
                </button>
                <button class="tt-btn-impersonate" @onclick="OpenAsSubAsync"
                        disabled="@(!IsSub(selectedEmployee))" title="Open the substitute timesheet review page scoped to this sub">
                    Open as Substitute →
                </button>
            </div>

            @if (isLoading)
            {
                <div class="tt-loading">Loading diagnostics…</div>
            }
            else if (diagnosticsLoaded)
            {
                @* HR Payroll Visibility Check — answers "why isn't this
                   employee showing on /hr/payroll?" by walking the three
                   filters in TimesheetService.GetPayrollSummariesAsync. *@
                <section class="tt-block tt-visibility">
                    <h3>HR Payroll Visibility (this pay period)</h3>
                    <table class="tt-kv">
                        <tr>
                            <th>IsActive</th>
                            <td>
                                @if (selectedEmployee.IsActive) { <span class="tt-pass">✓ active</span> }
                                else { <span class="tt-fail">✗ inactive — row will be HIDDEN. Reactivate in TC_Employees.</span> }
                            </td>
                        </tr>
                        <tr>
                            <th>EmployeeType</th>
                            <td>
                                @if (IsHourly(selectedEmployee))
                                {
                                    <span class="tt-pass">✓ @selectedEmployee.EmployeeType — qualifies for Hourly tab</span>
                                }
                                else if (IsSub(selectedEmployee))
                                {
                                    <span class="tt-info">ℹ Substitute — this employee shows on the Substitutes tab, not Hourly. Switch to /hr/payroll → Substitutes tab to find them.</span>
                                }
                                else
                                {
                                    <span class="tt-fail">✗ @selectedEmployee.EmployeeType — row will be HIDDEN on /hr/payroll. Only HourlyStaff / HourlyPartTime / Substitute appear there. Update via Manual Add or SQL.</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>TotalHours in period</th>
                            <td>
                                @{
                                    var dailyHours = dailyCards.Sum(d => d.TotalHours);
                                    var summaryHours = summary?.TotalHours ?? 0;
                                    var displayHours = summaryHours > 0 ? summaryHours : dailyHours;
                                    var punchDateSet = punches.Select(p => DateOnly.FromDateTime(p.PunchDateTime)).Distinct().ToList();
                                }
                                @if (displayHours > 0)
                                {
                                    <span class="tt-pass">✓ @displayHours.ToString("F2") — qualifies for HR Payroll display</span>
                                    @if (summaryHours == 0 && dailyHours > 0)
                                    {
                                        <span class="tt-info"> · Note: TC_PayPeriodSummary row is missing or stale. Daily timecards sum to @dailyHours.ToString("F2"). HR Payroll computes from daily timecards too, so this employee SHOULD show.</span>
                                    }
                                }
                                else
                                {
                                    <span class="tt-fail">
                                        ✗ 0.00 hours — row will be HIDDEN on Hourly tab.
                                    </span>
                                    <div class="tt-hint">
                                        Likely causes (check the Daily Timecards / Punches blocks below):
                                        <ul>
                                            <li>No <code>TC_TimePunches</code> rows exist in this period for this employee (currently @punches.Count punch rows in range)</li>
                                            <li>Punches exist but aren't paired (each IN needs a matching OUT) — recalc the affected dates</li>
                                            <li>Punches landed on dates OUTSIDE this period — check the Punches block dates</li>
                                            <li>CSV import succeeded but <code>RecalculateDailyTimecardAsync</code> errored silently — re-run recalc</li>
                                            <li><code>TC_DailyTimecards.TotalHours</code> is stale relative to current punches — recalc</li>
                                        </ul>
                                    </div>
                                    @if (punchDateSet.Count > 0)
                                    {
                                        <div class="tt-recalc-all">
                                            <button class="tt-btn-recalc-all"
                                                    @onclick="RecalcEntirePeriodAsync"
                                                    disabled="@isRecalcingAll">
                                                @(isRecalcingAll ? "Recalcing…" : $"Recalc all {punchDateSet.Count} dates with punches")
                                            </button>
                                            <span class="tt-recalc-hint">Re-runs <code>RecalculateDailyTimecardAsync</code> for every date in the period that has at least one punch row.</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(recalcAllMsg))
                                    {
                                        <div class="tt-recalc-result">@recalcAllMsg</div>
                                    }
                                }
                            </td>
                        </tr>
                    </table>
                </section>

                @* Period Summary *@
                <section class="tt-block">
                    <h3>Pay Period Summary</h3>
                    @if (summary != null)
                    {
                        <table class="tt-kv">
                            <tr><th>SummaryId</th><td>@summary.SummaryId</td></tr>
                            <tr><th>Period</th><td>@summary.PayPeriod?.PeriodName (@summary.PayPeriod?.StartDate – @summary.PayPeriod?.EndDate)</td></tr>
                            <tr><th>TotalHours</th><td>@summary.TotalHours.ToString("F2") (Reg @summary.TotalRegularHours.ToString("F2") · OT @summary.TotalOvertimeHours.ToString("F2"))</td></tr>
                            <tr><th>DaysWorked</th><td>@summary.DaysWorked</td></tr>
                            <tr><th>ApprovalStatus</th><td><strong>@summary.ApprovalStatus</strong></td></tr>
                            <tr><th>EmployeeApprovedBy</th><td>@(summary.EmployeeApprovedBy ?? "—") @(summary.EmployeeApprovedDate?.ToString("yyyy-MM-dd HH:mm") ?? "")</td></tr>
                            <tr><th>SupervisorApprovedBy</th><td>@(summary.SupervisorApprovedBy ?? "—") @(summary.SupervisorApprovedDate?.ToString("yyyy-MM-dd HH:mm") ?? "")</td></tr>
                            <tr><th>HRApprovedBy</th><td>@(summary.HRApprovedBy ?? "—") @(summary.HRApprovedDate?.ToString("yyyy-MM-dd HH:mm") ?? "")</td></tr>
                        </table>
                    }
                    else
                    {
                        <p class="tt-empty">No TC_PayPeriodSummary row exists for this employee in this pay period.</p>
                    }
                </section>

                @* Daily Timecards *@
                <section class="tt-block">
                    <h3>Daily Timecards (@dailyCards.Count)</h3>
                    @if (dailyCards.Any())
                    {
                        <table class="tt-list">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>First In</th>
                                    <th>Last Out</th>
                                    <th>Reg</th>
                                    <th>OT</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Exception</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in dailyCards)
                                {
                                    <tr>
                                        <td>@d.WorkDate</td>
                                        <td>@(d.FirstPunchIn?.ToString("h:mm tt") ?? "—")</td>
                                        <td>@(d.LastPunchOut?.ToString("h:mm tt") ?? "—")</td>
                                        <td>@d.RegularHours.ToString("F2")</td>
                                        <td>@d.OvertimeHours.ToString("F2")</td>
                                        <td><strong>@d.TotalHours.ToString("F2")</strong></td>
                                        <td>@d.ApprovalStatus</td>
                                        <td>@(d.HasException ? "⚠ " + (d.ExceptionNotes ?? "") : "—")</td>
                                        <td>
                                            <button class="tt-btn-recalc" @onclick="() => RecalcDayAsync(d.WorkDate)">Recalc</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="tt-empty">No daily timecards in this pay period.</p>
                    }
                </section>

                @* Time Punches *@
                <section class="tt-block">
                    <h3>Time Punches (@punches.Count)</h3>
                    @if (punches.Any())
                    {
                        <table class="tt-list">
                            <thead>
                                <tr>
                                    <th>PunchId</th>
                                    <th>Type</th>
                                    <th>DateTime</th>
                                    <th>Campus</th>
                                    <th>Status</th>
                                    <th>Source</th>
                                    <th>Paired</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in punches)
                                {
                                    <tr class="@(p.PunchStatus != PunchStatus.Active ? "voided" : "")">
                                        <td><code>@p.PunchId</code></td>
                                        <td>@p.PunchType</td>
                                        <td>@p.PunchDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@p.CampusId</td>
                                        <td>@p.PunchStatus</td>
                                        <td>@p.GeofenceStatus</td>
                                        <td>@(p.PairedPunchId?.ToString() ?? "—")</td>
                                        <td class="tt-notes">@(p.Notes ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="tt-empty">No punches in this pay period.</p>
                    }
                </section>

                @* Substitute timecards (sub only) *@
                @if (IsSub(selectedEmployee) && subCards.Any())
                {
                    <section class="tt-block">
                        <h3>Substitute Timecards (@subCards.Count)</h3>
                        <table class="tt-list">
                            <thead>
                                <tr>
                                    <th>WorkDate</th>
                                    <th>Campus</th>
                                    <th>Periods</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>ApprovedBy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in subCards)
                                {
                                    <tr>
                                        <td>@c.WorkDate</td>
                                        <td>@c.CampusId</td>
                                        <td>@c.PeriodEntries.Count</td>
                                        <td>@c.TotalPeriodsWorked</td>
                                        <td>@c.ApprovalStatus</td>
                                        <td>@(c.ApprovedBy ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                }

                @* Audit log *@
                <section class="tt-block">
                    <h3>Recent Audit Log (@auditEntries.Count)</h3>
                    @if (auditEntries.Any())
                    {
                        <table class="tt-list">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>ActionCode</th>
                                    <th>EntityType</th>
                                    <th>EntityId</th>
                                    <th>By</th>
                                    <th>Source</th>
                                    <th>Summary</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in auditEntries)
                                {
                                    <tr>
                                        <td>@a.CreatedDate.ToString("MM-dd HH:mm:ss")</td>
                                        <td><code>@a.ActionCode</code></td>
                                        <td>@a.EntityType</td>
                                        <td>@a.EntityId</td>
                                        <td>@(a.UserEmail ?? a.UserName ?? "—")</td>
                                        <td>@a.Source</td>
                                        <td class="tt-notes">@a.DeltaSummary</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="tt-empty">No audit entries scoped to this employee in this pay period.</p>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private string searchText = "";
    private bool isSearching = false;
    private bool isLoading = false;
    private bool diagnosticsLoaded = false;
    private string actionError = "";

    private List<TcEmployee> searchResults = new();
    private TcEmployee? selectedEmployee = null;

    // 2026-04-28: pay-period-scoped diagnostics. Replaces the free date range
    // picker so admins can step through periods one at a time and the
    // diagnostics directly correspond to a payroll boundary.
    private List<NewHeights.TimeClock.Web.Services.PayPeriodInfo> availablePeriods = new();
    private int selectedPayPeriodId = 0;
    // Derived from the selected period — kept as locals so the existing LINQ
    // queries against TC_DailyTimecards / TC_TimePunches / TC_AuditLogs don't
    // need restructuring.
    private DateOnly rangeStart = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly rangeEnd = DateOnly.FromDateTime(DateTime.Today);

    private TcPayPeriodSummary? summary;
    private List<TcDailyTimecard> dailyCards = new();
    private List<TcTimePunch> punches = new();
    private List<TcSubstituteTimecard> subCards = new();
    private List<TcAuditLog> auditEntries = new();

    private string currentUserEmail = "";

    // 2026-04-28: bulk-recalc-period button state.
    private bool isRecalcingAll = false;
    private string recalcAllMsg = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserEmail = auth.User.Identity?.Name ?? "";
        await LoadAvailablePeriodsAsync();
    }

    /// <summary>
    /// Load the last ~12 pay periods (anchored on the current period) so the
    /// dropdown gives admins a reasonable look-back window. Same convention as
    /// /hr/payroll and /supervisor/timesheets so users see a familiar list.
    /// </summary>
    private async Task LoadAvailablePeriodsAsync()
    {
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            var current = await PayPeriodService.GetCurrentPayPeriodAsync();
            // 12 periods back through 2 forward — covers the typical roster of
            // periods anyone would want to inspect on the troubleshoot page.
            var anchor = current.StartDate;
            var rows = await ctx.TcPayPeriods
                .AsNoTracking()
                .Where(p => p.StartDate >= anchor.AddMonths(-7) && p.StartDate <= anchor.AddMonths(2))
                .OrderByDescending(p => p.StartDate)
                .ToListAsync();
            availablePeriods = rows.Select(p => new NewHeights.TimeClock.Web.Services.PayPeriodInfo
            {
                PayPeriodId = p.PayPeriodId,
                PeriodName = p.PeriodName,
                StartDate = p.StartDate,
                EndDate = p.EndDate,
                // TC_PayPeriods.PayDate is nullable; PayPeriodInfo.PayDate
                // is not. Fall back to the period EndDate when the column
                // is NULL — only used as a display anchor on this page.
                PayDate = p.PayDate ?? p.EndDate
                // IsOpen is computed from EndDate; don't try to assign.
            }).ToList();
            selectedPayPeriodId = current.PayPeriodId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pay periods for troubleshoot page");
            actionError = "Could not load pay periods: " + ex.Message;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchText)) return;
        isSearching = true;
        actionError = "";
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            var q = searchText.Trim();
            var qLower = q.ToLowerInvariant();

            searchResults = await ctx.TcEmployees
                .AsNoTracking()
                .Include(e => e.Staff)
                .Include(e => e.HomeCampus)
                .Where(e =>
                    e.IdNumber.Contains(q)
                 || (e.Email != null && e.Email.ToLower().Contains(qLower))
                 || (e.DisplayName != null && e.DisplayName.ToLower().Contains(qLower))
                 || (e.Staff != null && (
                        e.Staff.FirstName.ToLower().Contains(qLower)
                     || e.Staff.LastName.ToLower().Contains(qLower)
                     || (e.Staff.FirstName + " " + e.Staff.LastName).ToLower().Contains(qLower))))
                .OrderByDescending(e => e.IsActive)
                .ThenBy(e => e.Staff != null ? e.Staff.LastName : (e.DisplayName ?? ""))
                .Take(50)
                .ToListAsync();

            selectedEmployee = null;
            diagnosticsLoaded = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Troubleshoot search failed");
            actionError = "Search failed: " + ex.Message;
        }
        finally { isSearching = false; }
    }

    private async Task SelectEmployeeAsync(int employeeId)
    {
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            selectedEmployee = await ctx.TcEmployees
                .AsNoTracking()
                .Include(e => e.Staff)
                .Include(e => e.HomeCampus)
                .Include(e => e.Supervisor).ThenInclude(s => s!.Staff)
                .FirstOrDefaultAsync(e => e.EmployeeId == employeeId);
            await LoadDiagnosticsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Troubleshoot select failed");
            actionError = "Could not load employee: " + ex.Message;
        }
    }

    private async Task LoadDiagnosticsAsync()
    {
        if (selectedEmployee == null) return;
        isLoading = true;
        actionError = "";
        diagnosticsLoaded = false;

        try
        {
            // Resolve the selected pay period — falls back to the current
            // period if the dropdown selection isn't in the list (e.g. on
            // first load before LoadAvailablePeriodsAsync settled).
            var period = availablePeriods.FirstOrDefault(p => p.PayPeriodId == selectedPayPeriodId);
            if (period == null)
            {
                period = await PayPeriodService.GetCurrentPayPeriodAsync();
                selectedPayPeriodId = period.PayPeriodId;
            }
            rangeStart = period.StartDate;
            rangeEnd = period.EndDate;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var empId = selectedEmployee.EmployeeId;

            // Period summary scoped to the exact selected period.
            summary = await ctx.TcPayPeriodSummaries
                .AsNoTracking()
                .Include(s => s.PayPeriod)
                .Where(s => s.EmployeeId == empId
                         && s.PayPeriodId == selectedPayPeriodId)
                .FirstOrDefaultAsync();

            dailyCards = await ctx.TcDailyTimecards
                .AsNoTracking()
                .Where(d => d.EmployeeId == empId
                         && d.WorkDate >= rangeStart
                         && d.WorkDate <= rangeEnd)
                .OrderBy(d => d.WorkDate)
                .ToListAsync();

            var startDt = rangeStart.ToDateTime(TimeOnly.MinValue);
            var endDt = rangeEnd.ToDateTime(TimeOnly.MaxValue);
            punches = await ctx.TcTimePunches
                .AsNoTracking()
                .Where(p => p.EmployeeId == empId
                         && p.PunchDateTime >= startDt
                         && p.PunchDateTime <= endDt)
                .OrderBy(p => p.PunchDateTime)
                .ToListAsync();

            subCards = await ctx.TcSubstituteTimecards
                .AsNoTracking()
                .Include(t => t.PeriodEntries)
                .Where(t => t.EmployeeId == empId
                         && t.WorkDate >= rangeStart
                         && t.WorkDate <= rangeEnd)
                .OrderBy(t => t.WorkDate)
                .ToListAsync();

            auditEntries = await ctx.TcAuditLogs
                .AsNoTracking()
                .Where(a => a.EmployeeId == empId
                         && a.CreatedDate >= startDt
                         && a.CreatedDate <= endDt)
                .OrderByDescending(a => a.CreatedDate)
                .Take(100)
                .ToListAsync();

            diagnosticsLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Troubleshoot load diagnostics failed");
            actionError = "Could not load diagnostics: " + ex.Message;
        }
        finally { isLoading = false; }
    }

    /// <summary>
    /// Re-run RecalculateDailyTimecardAsync for every distinct date in the
    /// loaded punch list. Useful when a CSV import created punches but the
    /// follow-on recalc errored silently — this is the one-click fix that
    /// most often resolves the "0 hours but punches exist" scenario.
    /// </summary>
    private async Task RecalcEntirePeriodAsync()
    {
        if (selectedEmployee == null || isRecalcingAll) return;
        isRecalcingAll = true;
        recalcAllMsg = "";
        try
        {
            var dates = punches
                .Select(p => DateOnly.FromDateTime(p.PunchDateTime))
                .Distinct()
                .OrderBy(d => d)
                .ToList();
            int ok = 0, failed = 0;
            foreach (var d in dates)
            {
                try
                {
                    await TimesheetService.RecalculateDailyTimecardAsync(selectedEmployee.EmployeeId, d);
                    ok++;
                }
                catch (Exception inner)
                {
                    Logger.LogWarning(inner, "Bulk recalc failed for {Emp} {Date}", selectedEmployee.EmployeeId, d);
                    failed++;
                }
            }
            await Audit.LogActionAsync(
                actionCode: AuditActions.Timecard.Recalculated,
                entityType: AuditEntityTypes.Employee,
                entityId: selectedEmployee.EmployeeId.ToString(),
                newValues: new
                {
                    selectedEmployee.EmployeeId,
                    PeriodStart = rangeStart,
                    PeriodEnd = rangeEnd,
                    DatesRecalced = dates.Count,
                    Succeeded = ok,
                    Failed = failed,
                    RecalcedBy = currentUserEmail,
                    Source = "TROUBLESHOOT_BULK"
                },
                deltaSummary: $"Admin bulk-recalc {dates.Count} date(s) for employee {selectedEmployee.EmployeeId} in {rangeStart:yyyy-MM-dd}..{rangeEnd:yyyy-MM-dd} via troubleshoot page ({ok} ok, {failed} failed)",
                source: AuditSource.AdminUi,
                employeeId: selectedEmployee.EmployeeId);
            recalcAllMsg = $"Recalced {ok} date(s){(failed > 0 ? $", {failed} failed" : "")}. Reloading diagnostics…";
            await LoadDiagnosticsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk recalc unexpected error");
            recalcAllMsg = "Failed: " + ex.Message;
        }
        finally
        {
            isRecalcingAll = false;
        }
    }

    private async Task RecalcDayAsync(DateOnly date)
    {
        if (selectedEmployee == null) return;
        try
        {
            await TimesheetService.RecalculateDailyTimecardAsync(selectedEmployee.EmployeeId, date);
            await Audit.LogActionAsync(
                actionCode: AuditActions.Timecard.Recalculated,
                entityType: AuditEntityTypes.Timecard,
                entityId: $"{selectedEmployee.EmployeeId}@{date:yyyy-MM-dd}",
                newValues: new { selectedEmployee.EmployeeId, date, RecalcedBy = currentUserEmail, Source = "TROUBLESHOOT" },
                deltaSummary: $"Admin recalc daily timecard {selectedEmployee.EmployeeId} {date:yyyy-MM-dd} via troubleshoot page",
                source: AuditSource.AdminUi,
                employeeId: selectedEmployee.EmployeeId);
            await LoadDiagnosticsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Recalc failed");
            actionError = "Recalc failed: " + ex.Message;
        }
    }

    private async Task OpenAsHourlyAsync()
    {
        if (selectedEmployee == null) return;
        // Audit the impersonation event so the trail clearly shows admin opened
        // the employee's view from the troubleshoot page.
        await Audit.LogActionAsync(
            actionCode: AuditActions.Timesheet.ImpersonationStarted,
            entityType: AuditEntityTypes.Employee,
            entityId: selectedEmployee.EmployeeId.ToString(),
            newValues: new { selectedEmployee.EmployeeId, OpenedBy = currentUserEmail, Mode = "HOURLY", Source = "TROUBLESHOOT" },
            deltaSummary: $"Admin {currentUserEmail} opened hourly timesheet view for employee {selectedEmployee.EmployeeId} from troubleshoot page",
            source: AuditSource.AdminUi,
            employeeId: selectedEmployee.EmployeeId);
        Navigation.NavigateTo($"/supervisor/timesheet/{selectedEmployee.EmployeeId}/0");
    }

    private async Task OpenAsSubAsync()
    {
        if (selectedEmployee == null) return;
        await Audit.LogActionAsync(
            actionCode: AuditActions.Timesheet.ImpersonationStarted,
            entityType: AuditEntityTypes.Employee,
            entityId: selectedEmployee.EmployeeId.ToString(),
            newValues: new { selectedEmployee.EmployeeId, OpenedBy = currentUserEmail, Mode = "SUB", Source = "TROUBLESHOOT" },
            deltaSummary: $"Admin {currentUserEmail} opened sub timesheet review for employee {selectedEmployee.EmployeeId} from troubleshoot page",
            source: AuditSource.AdminUi,
            employeeId: selectedEmployee.EmployeeId);
        // The supervisor sub-timesheet review page is the canonical admin
        // edit surface for sub timecards (it lets admins approve/reject and
        // edit per-period entries for any sub via the same UI sub managers
        // use). Routing here from the troubleshoot page keeps audit trails
        // clean and avoids re-implementing impersonation infrastructure.
        Navigation.NavigateTo("/supervisor/sub-timesheets");
    }

    private void ClearSelection()
    {
        selectedEmployee = null;
        diagnosticsLoaded = false;
        summary = null;
        dailyCards.Clear();
        punches.Clear();
        subCards.Clear();
        auditEntries.Clear();
    }

    private static bool IsHourly(TcEmployee e)
        => e.EmployeeType == EmployeeType.HourlyStaff || e.EmployeeType == EmployeeType.HourlyPartTime;
    private static bool IsSub(TcEmployee e)
        => e.EmployeeType == EmployeeType.Substitute;
}
