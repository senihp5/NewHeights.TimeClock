@page "/supervisor/timesheet/{EmployeeId:int}"
@page "/supervisor/timesheet/{EmployeeId:int}/{PeriodOffset:int}"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireSupervisor")]
@using NewHeights.TimeClock.Shared.Audit
@using NewHeights.TimeClock.Shared.Constants
@using NewHeights.TimeClock.Shared.Enums
@using NewHeights.TimeClock.Data
@using NewHeights.TimeClock.Data.Entities
@using NewHeights.TimeClock.Web.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<TimeClockDbContext> DbFactory
@inject ITimesheetService TimesheetService
@inject IPayPeriodService PayPeriodService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<SupervisorTimesheetView> Logger
@inject IEmailService EmailService
@inject IAuditService Audit

<PageTitle>Review Time Sheet - @employeeName</PageTitle>

<div class="supervisor-review-page">
    <nav class="breadcrumb">
        @* 2026-04-28: backPp query string round-trips the pay-period selection
           from Team Timesheets so the supervisor lands back on the same period
           they were reviewing. Falls back to the unfiltered URL when the deep-
           link was reached without a backPp (e.g. directly typed). *@
        <a href="@(BackPayPeriodId.HasValue ? $"/supervisor/timesheets/{BackPayPeriodId}" : "/supervisor/timesheets")">← Back to Team Timesheets</a>
    </nav>

    <header class="review-header">
        <div class="employee-card">
            @if (!string.IsNullOrEmpty(employeePhotoBase64))
            {
                <img src="data:image/jpeg;base64,@employeePhotoBase64" alt="@employeeName" class="employee-photo" />
            }
            else
            {
                <div class="employee-photo-placeholder">@employeeInitials</div>
            }
            <div class="employee-details">
                <h1>@employeeName</h1>
                <p class="employee-meta">ID: @employeeIdNumber • @employeePosition</p>
                <p class="employee-meta">Supervisor: @supervisorName</p>
            </div>
        </div>
        <div class="period-info">
            <div class="period-nav">
                <label for="sup-pp-picker" class="pp-label">Pay Period:</label>
                <select id="sup-pp-picker" class="btn-nav pp-select"
                        value="@selectedPayPeriodId"
                        @onchange="OnPayPeriodChangedAsync"
                        disabled="@isLoading">
                    @foreach (var p in availablePeriods)
                    {
                        <option value="@p.PayPeriodId">
                            @p.PeriodName (@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy"))
                            @(p.IsOpen ? " · Current" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="status-summary">
                <span class="status-item @(employeeApproved ? "approved" : "pending")">
                    Employee: @(employeeApproved ? "✓ Submitted" : "⏳ Pending")
                </span>
                <span class="status-item @(supervisorApproved ? "approved" : "pending")">
                    Supervisor: @(supervisorApproved ? "✓ Approved" : "⏳ Pending")
                </span>
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="loading">Loading time sheet...</div>
    }
    else if (payPeriodTimesheet != null)
    {
        <div class="period-summary-cards">
            <div class="summary-card">
                <span class="card-value">@payPeriodTimesheet.TotalHours.ToString("F2")</span>
                <span class="card-label">Total Hours</span>
            </div>
            <div class="summary-card">
                <span class="card-value">@payPeriodTimesheet.TotalRegularHours.ToString("F2")</span>
                <span class="card-label">Regular</span>
            </div>
            <div class="summary-card overtime">
                <span class="card-value">@payPeriodTimesheet.TotalOvertimeHours.ToString("F2")</span>
                <span class="card-label">Overtime</span>
            </div>
            <div class="summary-card">
                <span class="card-value">@payPeriodTimesheet.DaysWorked</span>
                <span class="card-label">Days Worked</span>
            </div>
            <div class="summary-card @(payPeriodTimesheet.ExceptionCount > 0 ? "warning" : "")">
                <span class="card-value">@payPeriodTimesheet.ExceptionCount</span>
                <span class="card-label">Exceptions</span>
            </div>
        </div>

        @* 2026-04-28: Flattened from per-week sections to a single per-pay-period
           table. The summary cards above already show the period total; dropping
           the per-week subtotal removes a layer of header noise so the supervisor
           scans all weekdays at once instead of hopping between Week 1 / Week 2. *@
        <div class="period-section">
            <table class="timesheet-table">
                    <thead>
                        <tr>
                            <th class="col-date">Date</th>
                            <th class="col-status">AM</th>
                            <th class="col-status">PM</th>
                            <th class="col-status">Evening</th>
                            <th class="col-hours">Hours</th>
                            <th class="col-hours">Holiday</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* 2026-04-28: skip weekend rows. School operates Mon–Fri;
                           Saturday/Sunday rows just add scroll without value
                           on the supervisor review. Punches that landed on a
                           weekend (rare — usually a kiosk timezone quirk) are
                           still in TC_TimePunches and would be caught by the
                           per-day exception drill-down on the troubleshoot
                           page. *@
                        @foreach (var day in payPeriodTimesheet.Weeks
                                                    .SelectMany(w => w.Days)
                                                    .Where(d => d.Date.DayOfWeek != DayOfWeek.Saturday
                                                             && d.Date.DayOfWeek != DayOfWeek.Sunday)
                                                    .OrderBy(d => d.Date))
                        {
                            var amStatus = GetShiftStatus(day, "AM");
                            var pmStatus = GetShiftStatus(day, "PM");
                            var eveningStatus = GetShiftStatus(day, "Evening");
                            var holidayHours = GetHolidayHours(day);
                            var isHoliday = holidayHours > 0;
                            var holidayName = GetHolidayName(day);
                            var isExpanded = expandedDays.Contains(day.Date);

                            <tr class="day-row @(day.HasException ? "has-exception" : "") @(isHoliday ? "holiday-row" : "") @(isExpanded ? "expanded" : "")"
                                @onclick="() => ToggleDayExpand(day.Date)"
                                style="cursor: pointer;">
                                <td class="col-date">
                                    <span class="expand-icon">@(isExpanded ? "▼" : "▶")</span>
                                    <span class="day-name">@day.DayOfWeek.Substring(0, 3)</span>
                                    <span class="day-date">@day.Date.ToString("M/d")</span>
                                    @if (isHoliday)
                                    {
                                        <span class="holiday-badge" title="@holidayName">@holidayName</span>
                                    }
                                    @* Arrival + departure summary on the
                                       collapsed row (matches MyTimesheet). *@
                                    @if (day.FirstIn != null || day.LastOut != null)
                                    {
                                        <div class="day-inout">
                                            @if (day.FirstIn != null)
                                            {
                                                <span class="inout-in" title="First clock-in">In @day.FirstIn.PunchTime.ToString("h:mm tt")</span>
                                            }
                                            @if (day.FirstIn != null && day.LastOut != null)
                                            {
                                                <span class="inout-sep">·</span>
                                            }
                                            @if (day.LastOut != null)
                                            {
                                                <span class="inout-out" title="Last clock-out">Out @day.LastOut.PunchTime.ToString("h:mm tt")</span>
                                            }
                                            else if (day.FirstIn != null)
                                            {
                                                <span class="inout-open" title="Still clocked in">(still in)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="col-status">
                                    @if (isHoliday)
                                    {
                                        <span class="status-pill holiday">Holiday</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill @amStatus.ToLower().Replace(" ", "-")">@amStatus</span>
                                    }
                                </td>
                                <td class="col-status">
                                    @if (isHoliday)
                                    {
                                        <span class="status-pill holiday">Holiday</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill @pmStatus.ToLower().Replace(" ", "-")">@pmStatus</span>
                                    }
                                </td>
                                <td class="col-status">
                                    @if (isHoliday)
                                    {
                                        <span class="status-pill holiday">Holiday</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill @eveningStatus.ToLower().Replace(" ", "-")">@eveningStatus</span>
                                    }
                                </td>
                                <td class="col-hours">
                                    <span class="hours-value">@day.TotalHours.ToString("F2")</span>
                                    @if (day.OvertimeHours > 0)
                                    {
                                        <span class="ot-badge">+@day.OvertimeHours.ToString("F2") OT</span>
                                    }
                                </td>
                                <td class="col-hours @(isHoliday ? "holiday-hours" : "")">
                                    @holidayHours.ToString("F2")
                                </td>
                                <td class="col-actions">
                                    @if (day.HasException)
                                    {
                                        <span class="exception-flag" title="@day.ExceptionNotes">⚠️</span>
                                    }
                                    @if (HasPendingCorrectionForDay(day.Date))
                                    {
                                        <span class="correction-flag" title="Employee correction request pending">📝</span>
                                    }
                                    <button class="btn-edit" @onclick="() => OpenEditDay(day)" @onclick:stopPropagation="true" title="Edit">✏️</button>
                                </td>
                            </tr>

                            @* ── Drill-down: Punch detail row ────────────────────────── *@
                            @if (isExpanded)
                            {
                                <tr class="punch-detail-row">
                                    <td colspan="7">
                                        <div class="punch-detail-panel">
                                            @if (day.Punches.Any())
                                            {
                                                @* 2026-04-28: Slot-table view modeled after the CSV import
                                                   preview (AM In, AM Out, PM In, PM Out, Eve In, Eve Out).
                                                   Block boundaries: AM before 12:30 PM, PM 12:30 PM through
                                                   4:30 PM, Eve after 4:30 PM. Punches that don't fit the
                                                   six slots drop into the Extras row below so orphan
                                                   auto-outs and duplicate INs surface for cleanup. *@
                                                var slots = GetDaySlots(day);
                                                var capturedDay = day; // closure target for the void buttons below
                                                var slotCells = new[]
                                                {
                                                    slots.AmIn, slots.AmOut,
                                                    slots.PmIn, slots.PmOut,
                                                    slots.EveIn, slots.EveOut
                                                };
                                                <table class="day-slots-table">
                                                    <thead>
                                                        <tr>
                                                            <th>AM In</th>
                                                            <th>AM Out</th>
                                                            <th>PM In</th>
                                                            <th>PM Out</th>
                                                            <th>Eve In</th>
                                                            <th>Eve Out</th>
                                                            <th>AM hrs</th>
                                                            <th>PM hrs</th>
                                                            <th>Eve hrs</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            @foreach (var cell in slotCells)
                                                            {
                                                                var capturedPunch = cell;
                                                                <td>
                                                                    @if (capturedPunch == null)
                                                                    {
                                                                        <span class="slot-empty" title="No punch recorded">—</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        var src = SourceTag(capturedPunch);
                                                                        <div class="slot-filled">
                                                                            <span class="slot-time">@(capturedPunch.RoundedTime?.ToString("h:mm tt") ?? capturedPunch.PunchTime.ToString("h:mm tt"))</span>
                                                                            <span class="slot-source @src.Css" title="@src.Label">@src.Label</span>
                                                                            <button class="slot-void"
                                                                                    @onclick="() => OpenVoidPunchDialog(capturedDay, capturedPunch)"
                                                                                    @onclick:stopPropagation="true"
                                                                                    title="Void this punch">🗑</button>
                                                                        </div>
                                                                    }
                                                                </td>
                                                            }
                                                            <td class="slot-hours">@slots.AmHours</td>
                                                            <td class="slot-hours">@slots.PmHours</td>
                                                            <td class="slot-hours">@slots.EveHours</td>
                                                        </tr>
                                                    </tbody>
                                                </table>

                                                @if (slots.Extras.Any())
                                                {
                                                    @* Extras: punches that don't fit the six canonical slots.
                                                       Most common cause: duplicate auto-outs at 9:00/9:30 PM,
                                                       or a second IN inside the same block. Each row carries a
                                                       Void button so the supervisor can soft-delete one click. *@
                                                    <div class="day-extras">
                                                        <h5 class="day-extras-title">Extras (don't fit AM / PM / Eve slots)</h5>
                                                        <table class="day-extras-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Type</th>
                                                                    <th>Time</th>
                                                                    <th>Rounded</th>
                                                                    <th>Source</th>
                                                                    <th>Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var extra in slots.Extras)
                                                                {
                                                                    var src = SourceTag(extra);
                                                                    var capturedExtra = extra; // closure capture
                                                                    <tr>
                                                                        <td>
                                                                            <span class="punch-type-pill @(extra.PunchType.Contains("Out", StringComparison.OrdinalIgnoreCase) ? "out" : "in")">
                                                                                @extra.PunchType
                                                                            </span>
                                                                        </td>
                                                                        <td>@extra.PunchTime.ToString("h:mm tt")</td>
                                                                        <td>@(extra.RoundedTime?.ToString("h:mm tt") ?? "—")</td>
                                                                        <td><span class="source-badge @src.Css">@src.Label</span></td>
                                                                        <td>
                                                                            <button class="btn-void-extra"
                                                                                    @onclick="() => OpenVoidPunchDialog(day, capturedExtra)"
                                                                                    @onclick:stopPropagation="true"
                                                                                    title="Void this punch (soft-delete; stays in audit log)">
                                                                                🗑 Void
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            }
                                            else if (!isHoliday)
                                            {
                                                <p class="no-punches-detail">No punches recorded for this day.</p>
                                            }

                                            @if (isHoliday)
                                            {
                                                <div class="holiday-notice">
                                                    🎉 <strong>@holidayName</strong> — @holidayHours.ToString("F2") holiday hours credited
                                                </div>
                                            }

                                            @if (day.HasException)
                                            {
                                                <div class="exception-notice">
                                                    ⚠️ <strong>Exception:</strong> @day.ExceptionNotes
                                                </div>
                                            }

                                            @{
                                                var dayCorrectionRequests = employeeCorrectionRequests
                                                    .Where(cr => cr.WorkDate == day.Date).ToList();
                                            }
                                            @if (dayCorrectionRequests.Any())
                                            {
                                                <div class="day-correction-requests">
                                                    <h5>📝 Employee Correction Requests</h5>
                                                    @foreach (var cr in dayCorrectionRequests)
                                                    {
                                                        <div class="correction-request-card @cr.Status.ToString().ToLower()">
                                                            <div class="cr-header">
                                                                <span class="cr-type">@FormatRequestType(cr.RequestType)</span>
                                                                <span class="cr-status-badge @cr.Status.ToString().ToLower()">@cr.Status</span>
                                                            </div>
                                                            <div class="cr-details">
                                                                @if (cr.RequestedDateTime.HasValue)
                                                                {
                                                                    <span>Requested time: <strong>@cr.RequestedDateTime.Value.ToString("h:mm tt")</strong></span>
                                                                }
                                                                <p class="cr-reason">@cr.Reason</p>
                                                            </div>
                                                            @if (cr.Status == CorrectionRequestStatus.Submitted)
                                                            {
                                                                <div class="cr-actions">
                                                                    <button class="btn-approve-cr"
                                                                            @onclick="() => ApproveCorrectionRequest(cr)"
                                                                            @onclick:stopPropagation="true">✓ Approve</button>
                                                                    <button class="btn-deny-cr"
                                                                            @onclick="() => DenyCorrectionRequest(cr)"
                                                                            @onclick:stopPropagation="true">✗ Deny</button>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <div class="drill-down-actions">
                                                <button class="btn-edit-drill"
                                                        @onclick="() => OpenEditDay(day)"
                                                        @onclick:stopPropagation="true">
                                                    ✏️ Add Correction
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        @if (PendingCorrectionRequests.Any())
        {
            <div class="corrections-queue-section">
                <h3>📝 Pending Correction Requests (@PendingCorrectionRequests.Count)</h3>
                <p class="section-subtitle">Employee-submitted requests awaiting your review</p>
                <table class="corrections-queue-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Requested</th>
                            <th>Reason</th>
                            <th>Submitted</th>
                            <th style="width:140px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cr in PendingCorrectionRequests)
                        {
                            <tr>
                                <td><strong>@cr.WorkDate.ToString("ddd M/d")</strong></td>
                                <td>@FormatRequestType(cr.RequestType)</td>
                                <td>@(cr.RequestedDateTime?.ToString("h:mm tt") ?? "—")</td>
                                <td>@cr.Reason</td>
                                <td>@cr.CreatedDate.ToString("M/d h:mm tt")</td>
                                <td>
                                    <div style="display:flex; gap:0.25rem;">
                                        <button class="btn-approve-cr" @onclick="() => ApproveCorrectionRequest(cr)">✓ Approve</button>
                                        <button class="btn-deny-cr" @onclick="() => DenyCorrectionRequest(cr)">✗ Deny</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (payPeriodTimesheet.ExceptionCount > 0)
        {
            <div id="exceptions" class="exceptions-section">
                <h3>⚠️ Exceptions Requiring Review</h3>
                <div class="exception-list">
                    @foreach (var day in payPeriodTimesheet.Weeks
                                                .SelectMany(w => w.Days)
                                                .Where(d => d.HasException)
                                                .OrderBy(d => d.Date))
                    {
                        <div class="exception-item">
                            <span class="exception-date">@day.Date.ToString("ddd M/d")</span>
                            <span class="exception-reason">@day.ExceptionNotes</span>
                            <button class="btn-resolve" @onclick="() => OpenEditDay(day)">Resolve</button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="approval-section">
            <h3>Supervisor Approval</h3>
            <div class="approval-box">
                @if (!employeeApproved)
                {
                    <div class="approval-warning">
                        <p>⚠️ This employee has not yet submitted their time sheet for this period.</p>
                        <button class="btn-remind" @onclick="SendReminder" disabled="@isSendingReminder">
                            @if (isSendingReminder)
                            {
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>📧 Send Reminder Email</span>
                            }
                        </button>
                        @if (!string.IsNullOrEmpty(reminderStatusMessage))
                        {
                            <div class="reminder-status @(reminderStatusIsError ? "error" : "success")" role="status" aria-live="polite">
                                @reminderStatusMessage
                            </div>
                        }
                    </div>
                }
                else if (supervisorApproved)
                {
                    <div class="already-approved">
                        <p>✓ Approved by @payPeriodTimesheet.SupervisorApprovedBy on @payPeriodTimesheet.SupervisorApprovedDate?.ToString("MMM d, yyyy h:mm tt")</p>
                    </div>
                }
                else
                {
                    <div class="approval-form">
                        <p>Review the time sheet above. If everything looks correct, approve to send to HR for final processing.</p>

                        @{
                            var unresolvedCount = payPeriodTimesheet.Weeks
                                .SelectMany(w => w.Days)
                                .Count(d => d.HasException);
                        }
                        @if (unresolvedCount > 0)
                        {
                            <div style="background:#fef3c7;border:1px solid #fde68a;color:#78350f;padding:0.6rem 0.75rem;border-radius:6px;margin:0.5rem 0;font-size:.9rem;">
                                ⚠️ <strong>@unresolvedCount exception@(unresolvedCount == 1 ? "" : "s") unresolved.</strong>
                                Resolve or acknowledge all exceptions before approving this time sheet.
                            </div>
                        }

                        <div class="supervisor-notes">
                            <label>Supervisor Notes (optional)</label>
                            <textarea @bind="supervisorNotes" placeholder="Add any notes about this time sheet..."></textarea>
                        </div>

                        <label class="approval-checkbox">
                            <input type="checkbox" @bind="approvalChecked" />
                            <span>I have reviewed this time sheet and confirm it is accurate</span>
                        </label>

                        <div class="approval-actions">
                            <button class="btn-approve" @onclick="ApproveTimesheet"
                                    disabled="@(!approvalChecked || isApproving || unresolvedCount > 0)">
                                @if (isApproving)
                                {
                                    <span>Approving...</span>
                                }
                                else
                                {
                                    <span>✓ Approve Time Sheet</span>
                                }
                            </button>
                            <button class="btn-reject" @onclick="OpenRejectModal">✗ Request Corrections</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showEditModal && editingDay != null)
{
    <div class="modal-overlay" @onclick="CloseEditModal">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Edit Time Entry - @editingDay.Date.ToString("dddd, MMMM d")</h2>
                <button class="modal-close" @onclick="CloseEditModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="current-punches">
                    <h4>Current Punches</h4>
                    @if (editingDay.Punches.Any())
                    {
                        @foreach (var punch in editingDay.Punches)
                        {
                            <div class="punch-row">
                                <span class="punch-type">@FormatPunchType(punch.PunchType)</span>
                                <span class="punch-time">@punch.PunchTime.ToString("h:mm tt")</span>
                                @if (punch.IsManual)
                                {
                                    <span class="manual-tag">Manual</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="no-data">No punches recorded</p>
                    }
                </div>

                <hr />

                @if (pendingVoidPunchId.HasValue)
                {
                    @* Void queue: the supervisor clicked 🗑 on a slot/extras
                       row. The punch is committed (PunchStatus = Voided) on
                       Save. Showing the summary here so it's clear what's
                       about to be deleted. *@
                    <div class="void-pending-banner">
                        <strong>🗑 Punch queued for void:</strong> @pendingVoidPunchSummary
                        <button type="button" class="link-btn" @onclick="CancelPendingVoid">Cancel void</button>
                    </div>
                }

                <h4>Edit Entry</h4>

                <label style="display:flex;align-items:center;gap:6px;margin:0.5rem 0;">
                    <input type="checkbox" @bind="addPunchInCorrection" />
                    <span>Add a new punch entry</span>
                </label>

                @if (addPunchInCorrection)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label>Punch Type</label>
                            <select @bind="newPunchType">
                                <option value="In">Clock In</option>
                                <option value="Out">Clock Out</option>
                                <option value="LunchOut">Lunch Out</option>
                                <option value="LunchIn">Lunch In</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Time</label>
                            <input type="time" @bind="newPunchTime" />
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label>Reason *</label>
                    <textarea @bind="correctionReason" placeholder="Required: Explain the correction, acknowledgment, or flag..."></textarea>
                </div>

                @if (editingDay.HasException)
                {
                    <div class="exception-info">
                        <label>Current Exception</label>
                        <p>@editingDay.ExceptionNotes</p>
                        <label class="resolve-checkbox">
                            <input type="checkbox" @bind="markExceptionResolved" />
                            <span>Mark exception as resolved (acknowledged)</span>
                        </label>
                    </div>
                }

                <label class="resolve-checkbox" style="margin-top:0.5rem;">
                    <input type="checkbox" @bind="flagAsException" />
                    <span>Flag this day as an exception for follow-up</span>
                </label>
                @if (flagAsException && markExceptionResolved)
                {
                    <div style="color:#b45309;font-size:.85rem;margin-top:.25rem;">
                        Resolve and Flag are mutually exclusive. Resolve wins; flag will be ignored.
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseEditModal">Cancel</button>
                <button class="btn-save" @onclick="SaveCorrection"
                        disabled="@(string.IsNullOrWhiteSpace(correctionReason) || (!addPunchInCorrection && !markExceptionResolved && !flagAsException && !pendingVoidPunchId.HasValue))">
                    Save
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int EmployeeId { get; set; }
    [Parameter] public int PeriodOffset { get; set; } = 0;

    // 2026-04-28: optional query-string carrier so the breadcrumb back-link
    // returns to the exact pay-period the supervisor was filtered to on the
    // Team Timesheets page. Set by Team Timesheets via ?backPp={PayPeriodId}.
    // Null when the page is reached directly (no breadcrumb context).
    [Parameter, SupplyParameterFromQuery(Name = "backPp")] public int? BackPayPeriodId { get; set; }

    private int periodOffset = 0;
    private DateTime periodAnchorDate = DateTime.Today;
    private bool isLoading = true;
    private bool isApproving = false;
    private bool approvalChecked = false;
    private string supervisorNotes = "";
    private string currentUserEmail = "";
    private string currentUserName = "";

    // Employee info
    private string employeeName = "";
    private string employeeIdNumber = "";
    private string employeePosition = "";
    private string supervisorName = "";
    private string employeeInitials = "";
    private string employeeEmail = "";
    private string? employeePhotoBase64;
    private bool isHolidayEligible = true;

    // Approval status
    private bool employeeApproved = false;
    private bool supervisorApproved = false;

    // Data
    private PayPeriodInfo? currentPayPeriod;
    private PayPeriodTimesheet? payPeriodTimesheet;

    // Pay-period dropdown (replaced prev/next buttons 2026-04-24).
    private List<PayPeriodInfo> availablePeriods = new();
    private int selectedPayPeriodId = 0;

    // Drill-down state
    private HashSet<DateOnly> expandedDays = new();

    // Holiday data
    private List<TcHolidaySchedule> weekHolidays = new();

    // Pending employee correction requests
    private List<TcCorrectionRequest> employeeCorrectionRequests = new();
    private List<TcCorrectionRequest> PendingCorrectionRequests =>
        employeeCorrectionRequests.Where(cr => cr.Status == CorrectionRequestStatus.Submitted).ToList();

    // Edit modal
    private bool showEditModal = false;
    private DailyTimesheetEntry? editingDay;
    private string newPunchType = "In";
    private TimeOnly newPunchTime = new TimeOnly(8, 0);
    private string correctionReason = "";
    private bool markExceptionResolved = false;
    private bool addPunchInCorrection = false;
    private bool flagAsException = false;

    // Reminder email feedback — surfaces the result of SendTimesheetReminderAsync
    // so supervisors see a confirmation / error message instead of the button
    // silently doing nothing. Auto-clears after a few seconds on success.
    private bool isSendingReminder = false;
    private string reminderStatusMessage = "";
    private bool reminderStatusIsError = false;

    protected override async Task OnInitializedAsync()
    {
        periodOffset = PeriodOffset;
        for (int i = 0; i < Math.Abs(PeriodOffset); i++)
            periodAnchorDate = NavigatePeriod(periodAnchorDate, PeriodOffset < 0 ? -1 : 1);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserEmail = user.FindFirst("preferred_username")?.Value ??
                           user.FindFirst(ClaimTypes.Email)?.Value ?? "";
        currentUserName = user.FindFirst("name")?.Value ??
                          user.FindFirst(ClaimTypes.Name)?.Value ?? currentUserEmail;

        // Populate pay-period dropdown; seed from URL offset for back-compat.
        availablePeriods = await PayPeriodService.GetRecentPayPeriodsAsync();

        // 2026-04-28 (fix): Team Timesheets passes ?backPp={selectedPayPeriodId}
        // on the deep-link. The route's PeriodOffset is hardcoded to 0 from
        // that page (it never recomputes when the supervisor changes the
        // dropdown), so honoring backPp first guarantees we land on the EXACT
        // pay period the supervisor was viewing — not whatever period the
        // stale offset arithmetic resolves to. Falls back to the offset-based
        // seed only when no backPp hint was provided (direct link, bookmark).
        if (BackPayPeriodId.HasValue && availablePeriods.Any(p => p.PayPeriodId == BackPayPeriodId.Value))
        {
            selectedPayPeriodId = BackPayPeriodId.Value;
        }
        else
        {
            var initialPeriod = await PayPeriodService.GetPayPeriodForDateAsync(periodAnchorDate);
            selectedPayPeriodId = availablePeriods.Any(p => p.PayPeriodId == initialPeriod.PayPeriodId)
                ? initialPeriod.PayPeriodId
                : availablePeriods.FirstOrDefault(p => p.IsOpen)?.PayPeriodId ?? availablePeriods.FirstOrDefault()?.PayPeriodId ?? 0;
        }

        await LoadEmployeeData();
    }

    private async Task OnPayPeriodChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) return;
        selectedPayPeriodId = id;
        expandedDays.Clear();
        await LoadTimesheet();
    }

    private async Task LoadEmployeeData()
    {
        isLoading = true;

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var employee = await context.TcEmployees
                .Include(e => e.Staff)
                .Include(e => e.Supervisor).ThenInclude(s => s!.Staff)
                .FirstOrDefaultAsync(e => e.EmployeeId == EmployeeId);

            if (employee != null)
            {
                employeeName = employee.Staff?.FullName ?? "Unknown";
                employeeIdNumber = employee.IdNumber;
                employeePosition = employee.EmployeeType.ToString();
                supervisorName = employee.Supervisor?.Staff?.FullName ?? "Unassigned";
                employeeInitials = GetInitials(employeeName);
                employeeEmail = employee.Email ?? "";
                isHolidayEligible = employee.EmployeeType != EmployeeType.HourlyPartTime
                                 && employee.EmployeeType != EmployeeType.Substitute;

                // Load photo
                if (employee.StaffDcid > 0)
                {
                    var photo = await context.Photos
                        .FirstOrDefaultAsync(p => p.SubjectDcid == employee.StaffDcid && p.SubjectType == 1);
                    if (photo?.PhotoData != null)
                    {
                        employeePhotoBase64 = Convert.ToBase64String(photo.PhotoData);
                    }
                }

                await LoadTimesheet();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employee {EmployeeId}", EmployeeId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTimesheet()
    {
        // Dropdown-driven. Fall back to today's period if selection is stale.
        currentPayPeriod = availablePeriods.FirstOrDefault(p => p.PayPeriodId == selectedPayPeriodId)
                        ?? await PayPeriodService.GetCurrentPayPeriodAsync();

        payPeriodTimesheet = await TimesheetService.GetPayPeriodTimesheetAsync(
            EmployeeId,
            currentPayPeriod.StartDate,
            currentPayPeriod.EndDate);

        employeeApproved = payPeriodTimesheet.EmployeeApprovalStatus != ApprovalStatus.Pending;
        supervisorApproved = payPeriodTimesheet.SupervisorApprovalStatus == ApprovalStatus.Approved ||
                             payPeriodTimesheet.SupervisorApprovalStatus == ApprovalStatus.Locked;

        // Load holidays for the pay period
        using var ctx = await DbFactory.CreateDbContextAsync();
        weekHolidays = await ctx.TcHolidaySchedules
            .AsNoTracking()
            .Where(h => h.IsActive && h.HolidayDate >= currentPayPeriod.StartDate && h.HolidayDate <= currentPayPeriod.EndDate)
            .ToListAsync();

        // Load pending correction requests from this employee
        employeeCorrectionRequests = await ctx.TcCorrectionRequests
            .AsNoTracking()
            .Where(cr => cr.EmployeeId == EmployeeId &&
                         cr.WorkDate >= currentPayPeriod.StartDate && cr.WorkDate <= currentPayPeriod.EndDate)
            .OrderByDescending(cr => cr.CreatedDate)
            .ToListAsync();

        approvalChecked = false;
        supervisorNotes = "";
        StateHasChanged();
    }

    // PreviousPeriod / NextPeriod removed 2026-04-24 — OnPayPeriodChangedAsync
    // handles dropdown-driven navigation now.

    private async Task ApproveTimesheet()
    {
        if (!approvalChecked || isApproving || currentPayPeriod == null) return;

        isApproving = true;
        try
        {
            await TimesheetService.ApproveTimesheetAsync(
                EmployeeId,
                currentPayPeriod.StartDate,
                currentPayPeriod.EndDate,
                currentUserEmail,
                "Supervisor");

            // Send approval notification to employee
            if (!string.IsNullOrEmpty(employeeEmail))
            {
                await EmailService.SendApprovalNotificationAsync(
                    employeeEmail,
                    employeeName.Split(' ').FirstOrDefault() ?? employeeName,
                    currentUserName,
                    currentPayPeriod?.PeriodName ?? "this pay period");
            }

            await LoadTimesheet();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error approving timesheet");
        }
        finally
        {
            isApproving = false;
        }
    }

    private void OpenRejectModal()
    {
        // TODO: Implement rejection/request corrections workflow
        Logger.LogInformation("Reject requested for employee {EmployeeId}", EmployeeId);
    }

    private async Task SendReminder()
    {
        if (isSendingReminder) return;

        // Guard against missing data FIRST so the supervisor sees why the
        // button didn't do anything instead of guessing. Previous behavior
        // returned silently when employeeEmail was empty.
        if (string.IsNullOrEmpty(employeeEmail))
        {
            reminderStatusIsError = true;
            reminderStatusMessage = $"No email address on file for {employeeName}. Reminder not sent.";
            StateHasChanged();
            return;
        }
        if (currentPayPeriod == null)
        {
            reminderStatusIsError = true;
            reminderStatusMessage = "Pay period not loaded yet. Try again in a moment.";
            StateHasChanged();
            return;
        }

        isSendingReminder = true;
        reminderStatusMessage = "";
        reminderStatusIsError = false;
        StateHasChanged();

        bool sendSuccess = false;
        string? errorDetail = null;
        var sentAt = DateTime.Now;

        try
        {
            // ── 1. Attempt the SMTP send. ──────────────────────────────
            try
            {
                sendSuccess = await EmailService.SendTimesheetReminderAsync(
                    employeeEmail,
                    employeeName.Split(' ').FirstOrDefault() ?? employeeName,
                    currentUserName,
                    currentPayPeriod.EmployeeDeadline);

                if (!sendSuccess)
                {
                    errorDetail = "SMTP send returned false. Check EmailService configuration or server logs.";
                }
            }
            catch (Exception ex)
            {
                errorDetail = ex.Message;
                Logger.LogError(ex, "Error sending reminder to employee {EmployeeId}", EmployeeId);
            }

            // ── 2. Persist the outcome so HR/compliance can audit it. ──
            // Two writes: (a) upsert a TcTimesheetReminderLog row tagged
            // ReminderType=MANUAL_SUPERVISOR, which keeps Patrick's dedup
            // log queryable for manual sends alongside automated ones;
            // (b) append an immutable audit row per click, so repeated
            // clicks leave a complete trail even though the reminder-log
            // row only stores the *latest* manual send per (pp,emp).
            // Wrapped in its own try/catch so a log failure can't hide
            // the email outcome from the supervisor.
            try
            {
                using var ctx = await DbFactory.CreateDbContextAsync();
                var deliveryStatus = sendSuccess ? "SENT" : "FAILED";

                var existing = await ctx.TcTimesheetReminderLogs
                    .FirstOrDefaultAsync(r =>
                        r.PayPeriodId == currentPayPeriod.PayPeriodId &&
                        r.EmployeeId == EmployeeId &&
                        r.ReminderType == "MANUAL_SUPERVISOR");

                if (existing == null)
                {
                    ctx.TcTimesheetReminderLogs.Add(new TcTimesheetReminderLog
                    {
                        PayPeriodId    = currentPayPeriod.PayPeriodId,
                        EmployeeId     = EmployeeId,
                        ReminderType   = "MANUAL_SUPERVISOR",
                        SentAt         = sentAt,
                        DeliveryStatus = deliveryStatus,
                        ErrorMessage   = errorDetail
                    });
                }
                else
                {
                    existing.SentAt         = sentAt;
                    existing.DeliveryStatus = deliveryStatus;
                    existing.ErrorMessage   = errorDetail;
                }

                await ctx.SaveChangesAsync();

                await Audit.LogActionAsync(
                    actionCode: sendSuccess
                        ? AuditActions.Timesheet.ReminderEmailSent
                        : AuditActions.Timesheet.ReminderEmailFailed,
                    entityType: AuditEntityTypes.Employee,
                    entityId: EmployeeId.ToString(),
                    newValues: new
                    {
                        EmployeeId,
                        EmployeeName     = employeeName,
                        EmployeeEmail    = employeeEmail,
                        PayPeriodId      = currentPayPeriod.PayPeriodId,
                        PeriodName       = currentPayPeriod.PeriodName,
                        EmployeeDeadline = currentPayPeriod.EmployeeDeadline.ToString("yyyy-MM-dd"),
                        SentBy           = currentUserEmail,
                        SentAt           = sentAt.ToString("yyyy-MM-dd HH:mm:ss"),
                        DeliveryStatus   = deliveryStatus,
                        ErrorMessage     = errorDetail
                    },
                    deltaSummary: sendSuccess
                        ? $"Manual timesheet reminder emailed to {employeeName} <{employeeEmail}> for {currentPayPeriod.PeriodName} by {currentUserEmail}"
                        : $"Manual timesheet reminder to {employeeName} <{employeeEmail}> for {currentPayPeriod.PeriodName} by {currentUserEmail} FAILED: {errorDetail}",
                    source: AuditSource.AdminUi,
                    employeeId: EmployeeId);
            }
            catch (Exception logEx)
            {
                Logger.LogError(logEx,
                    "Reminder persisted-log write failed for employee {EmployeeId} (email outcome was {Outcome}). " +
                    "Audit/dedup row may be missing.",
                    EmployeeId, sendSuccess ? "success" : "failure");
            }

            // ── 3. Update the UI feedback. ─────────────────────────────
            if (sendSuccess)
            {
                reminderStatusIsError = false;
                reminderStatusMessage = $"✓ Reminder sent to {employeeEmail}";
                Logger.LogInformation("Reminder sent to {Employee} ({Email})", employeeName, employeeEmail);
            }
            else
            {
                reminderStatusIsError = true;
                reminderStatusMessage = $"Reminder to {employeeEmail} was not sent. {errorDetail}".TrimEnd();
                Logger.LogWarning(
                    "Reminder send failed for {Employee} ({Email}): {Error}",
                    employeeName, employeeEmail, errorDetail);
            }
        }
        finally
        {
            isSendingReminder = false;
            StateHasChanged();
        }

        // Auto-clear success toasts after 6s so the supervisor doesn't see
        // stale feedback next time they land on this page. Errors persist
        // until the supervisor retries — they're intentionally stickier.
        if (!reminderStatusIsError && !string.IsNullOrEmpty(reminderStatusMessage))
        {
            var stamp = reminderStatusMessage;
            _ = Task.Run(async () =>
            {
                await Task.Delay(6000);
                // Only clear if the message we wrote is still the visible one
                // (prevents clobbering a newer error the supervisor may now be reading).
                if (reminderStatusMessage == stamp)
                {
                    reminderStatusMessage = "";
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
    }

    private void OpenEditDay(DailyTimesheetEntry day)
    {
        editingDay = day;
        newPunchType = "In";
        newPunchTime = new TimeOnly(8, 0);
        correctionReason = "";
        markExceptionResolved = false;
        // Default the modal to acknowledge-mode (no punch) when opening on an
        // exception day. That way the Resolve button on an exception doesn't
        // silently add an 8:00 AM IN punch if the supervisor forgets to uncheck.
        addPunchInCorrection = !day.HasException;
        flagAsException = false;
        // Clear any stale void queue so the pencil-edit modal doesn't pick
        // up a punch the supervisor queued and abandoned earlier.
        pendingVoidPunchId = null;
        pendingVoidPunchSummary = "";
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingDay = null;
        addPunchInCorrection = false;
        flagAsException = false;
        pendingVoidPunchId = null;
        pendingVoidPunchSummary = "";
    }

    /// <summary>Drops a queued void without closing the modal — supervisor
    /// can change their mind and pick a different action instead.</summary>
    private void CancelPendingVoid()
    {
        pendingVoidPunchId = null;
        pendingVoidPunchSummary = "";
    }

    private async Task SaveCorrection()
    {
        if (editingDay == null || string.IsNullOrWhiteSpace(correctionReason)) return;
        if (!addPunchInCorrection && !markExceptionResolved && !flagAsException && !pendingVoidPunchId.HasValue) return;

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var employee = await context.TcEmployees.FindAsync(EmployeeId);
            if (employee == null) return;

            TcTimePunch? newPunch = null;

            // 0. Soft-delete (void) a punch when queued via the 🗑 buttons
            //    on the slot table or Extras list. Voided punches drop out of
            //    the timesheet view (TimesheetService filters PunchStatus =
            //    Active) and stop counting toward hours, but the row stays
            //    in the database for audit. Any paired-punch linkage on the
            //    surviving partner is cleared so the next render doesn't
            //    show a phantom pair pointing at a voided ID.
            if (pendingVoidPunchId.HasValue)
            {
                var voidTarget = await context.TcTimePunches
                    .FirstOrDefaultAsync(p => p.PunchId == pendingVoidPunchId.Value
                                           && p.EmployeeId == EmployeeId
                                           && p.PunchStatus == PunchStatus.Active);
                if (voidTarget != null)
                {
                    var oldStatus = voidTarget.PunchStatus.ToString();
                    voidTarget.PunchStatus = PunchStatus.Voided;
                    voidTarget.IsModified = true;
                    voidTarget.ModifiedBy = currentUserEmail;
                    voidTarget.ModifiedReason = $"[Supervisor Void] {correctionReason}";

                    // Break the pairing on the surviving partner so the day
                    // re-renders cleanly. We don't delete the partner — only
                    // the punch the supervisor explicitly queued.
                    if (voidTarget.PairedPunchId.HasValue)
                    {
                        var partner = await context.TcTimePunches
                            .FirstOrDefaultAsync(p => p.PunchId == voidTarget.PairedPunchId.Value);
                        if (partner != null && partner.PairedPunchId == voidTarget.PunchId)
                        {
                            partner.PairedPunchId = null;
                        }
                        voidTarget.PairedPunchId = null;
                    }

                    await context.SaveChangesAsync();

                    await Audit.LogActionAsync(
                        actionCode: AuditActions.Punch.Modified,
                        entityType: AuditEntityTypes.Punch,
                        entityId: voidTarget.PunchId.ToString(),
                        oldValues: new { PunchStatus = oldStatus },
                        newValues: new
                        {
                            PunchStatus = voidTarget.PunchStatus.ToString(),
                            voidTarget.PunchType,
                            voidTarget.PunchDateTime,
                            voidTarget.IsAutoCheckout,
                            VoidedBy = currentUserEmail,
                            Source = "SUPERVISOR_VOID"
                        },
                        reason: correctionReason,
                        deltaSummary:
                            $"Supervisor voided {voidTarget.PunchType} at {voidTarget.PunchDateTime:MMM d h:mm tt} for employee {EmployeeId} by {currentUserEmail}",
                        source: AuditSource.AdminUi,
                        employeeId: EmployeeId,
                        punchId: voidTarget.PunchId);

                    await TimesheetService.RecalculateDailyTimecardAsync(EmployeeId, editingDay.Date);
                }
            }

            // 1. Optional punch creation
            if (addPunchInCorrection)
            {
                var punchDateTime = editingDay.Date.ToDateTime(newPunchTime);
                var punchType = Enum.Parse<PunchType>(newPunchType);

                newPunch = new TcTimePunch
                {
                    EmployeeId = EmployeeId,
                    CampusId = employee.HomeCampusId,
                    PunchType = punchType,
                    PunchDateTime = punchDateTime,
                    RoundedDateTime = RoundToQuarterHour(punchDateTime),
                    VerificationMethod = "MANUAL",
                    ScanMethod = "SUPERVISOR",
                    IsManualEntry = true,
                    IsModified = true,
                    ModifiedBy = currentUserEmail,
                    ModifiedReason = $"[Supervisor Correction] {correctionReason}",
                    Notes = correctionReason,
                    PunchStatus = PunchStatus.Active,
                    CreatedDate = DateTime.Now
                };

                context.TcTimePunches.Add(newPunch);
                await context.SaveChangesAsync();

                await Audit.LogActionAsync(
                    actionCode: AuditActions.Punch.Modified,
                    entityType: AuditEntityTypes.Punch,
                    entityId: newPunch.PunchId.ToString(),
                    newValues: new
                    {
                        newPunch.PunchId,
                        newPunch.EmployeeId,
                        newPunch.CampusId,
                        PunchType = newPunch.PunchType.ToString(),
                        newPunch.PunchDateTime,
                        ScanMethod = newPunch.ScanMethod,
                        Source = "SUPERVISOR_CORRECTION"
                    },
                    reason: correctionReason,
                    deltaSummary:
                        $"Supervisor correction: added {newPunch.PunchType} at {newPunch.PunchDateTime:MMM d h:mm tt} for employee {EmployeeId} by {currentUserEmail}",
                    source: AuditSource.AdminUi,
                    employeeId: EmployeeId,
                    punchId: newPunch.PunchId);

                await TimesheetService.RecalculateDailyTimecardAsync(EmployeeId, editingDay.Date);
            }

            // 2. Exception state change: resolve OR flag (Resolve wins if both)
            if (markExceptionResolved || flagAsException)
            {
                var timecard = await context.TcDailyTimecards
                    .FirstOrDefaultAsync(t => t.EmployeeId == EmployeeId && t.WorkDate == editingDay.Date);

                if (timecard == null && flagAsException)
                {
                    timecard = new TcDailyTimecard
                    {
                        EmployeeId = EmployeeId,
                        CampusId = employee.HomeCampusId,
                        WorkDate = editingDay.Date,
                        ApprovalStatus = ApprovalStatus.Pending,
                        CreatedDate = DateTime.Now,
                        ModifiedDate = DateTime.Now
                    };
                    context.TcDailyTimecards.Add(timecard);
                }

                if (timecard != null)
                {
                    if (markExceptionResolved)
                    {
                        timecard.HasException = false;
                        timecard.ExceptionNotes =
                            $"Acknowledged by {currentUserName} on {DateTime.Now:MMM d h:mm tt}: {correctionReason}";
                    }
                    else if (flagAsException)
                    {
                        timecard.HasException = true;
                        timecard.ExceptionNotes =
                            $"Flagged by {currentUserName} on {DateTime.Now:MMM d h:mm tt}: {correctionReason}";
                    }
                    timecard.ModifiedDate = DateTime.Now;
                    await context.SaveChangesAsync();

                    await Audit.LogActionAsync(
                        actionCode: markExceptionResolved
                            ? AuditActions.Timesheet.ExceptionAcknowledged
                            : AuditActions.Timesheet.ExceptionFlagged,
                        entityType: AuditEntityTypes.Timecard,
                        entityId: timecard.TimecardId.ToString(),
                        newValues: new
                        {
                            timecard.TimecardId,
                            timecard.EmployeeId,
                            WorkDate = timecard.WorkDate.ToString("yyyy-MM-dd"),
                            HasException = timecard.HasException,
                            PunchCreated = newPunch?.PunchId,
                            Actor = currentUserEmail
                        },
                        reason: correctionReason,
                        deltaSummary: markExceptionResolved
                            ? $"Exception acknowledged on {timecard.WorkDate:MMM d} by {currentUserEmail} for employee {EmployeeId}"
                            : $"Day {timecard.WorkDate:MMM d} flagged as exception by {currentUserEmail} for employee {EmployeeId}",
                        source: AuditSource.AdminUi,
                        employeeId: EmployeeId);
                }
            }

            Logger.LogInformation(
                "Supervisor {Supervisor} edit on {Date} for employee {Employee}: AddPunch={AddPunch}, Resolve={Resolve}, Flag={Flag}",
                currentUserEmail, editingDay.Date, EmployeeId,
                addPunchInCorrection, markExceptionResolved, flagAsException);

            CloseEditModal();
            await LoadTimesheet();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving correction");
        }
    }

    private void ToggleDayExpand(DateOnly date)
    {
        if (!expandedDays.Remove(date))
            expandedDays.Add(date);
    }

    private decimal GetHolidayHours(DailyTimesheetEntry day)
    {
        if (!isHolidayEligible) return 0;
        var holiday = weekHolidays.FirstOrDefault(h => h.HolidayDate == day.Date);
        return holiday?.HoursCredited ?? 0;
    }

    private string GetHolidayName(DailyTimesheetEntry day)
    {
        return weekHolidays.FirstOrDefault(h => h.HolidayDate == day.Date)?.HolidayName ?? "";
    }

    private bool HasPendingCorrectionForDay(DateOnly date)
    {
        return employeeCorrectionRequests.Any(cr => cr.WorkDate == date && cr.Status == CorrectionRequestStatus.Submitted);
    }

    /// <summary>
    /// Builds a slot-based view of a day's punches that mirrors the CSV
    /// import's AM / PM / Eve column layout. Each work-block exposes one IN
    /// slot and one OUT slot; punches that don't fit any slot land in Extras
    /// so the supervisor can void them.
    ///
    /// Block boundaries (matching the Stop Six reception schedule + general
    /// night session):
    ///   AM  = punch time before 12:30 PM
    ///   PM  = 12:30 PM through 4:30 PM (inclusive of 4:30)
    ///   Eve = after 4:30 PM
    ///
    /// Within each block: first IN-type punch fills the In slot, first OUT-
    /// type punch fills the Out slot. Lunch / Break punches and any second
    /// IN or OUT inside a block are pushed to Extras. This makes a missing
    /// AM IN visually obvious — the AM In cell sits empty next to a filled
    /// AM Out, instead of the old pair-by-index layout that hid the gap by
    /// re-pairing the next IN against the orphan OUT.
    /// </summary>
    private DaySlotView GetDaySlots(DailyTimesheetEntry day)
    {
        // 2026-04-28 (rewrite): Pair-aware slot assignment.
        //
        // Original version classified every punch independently by clock
        // time, which produced nonsensical pairings on real data: a 7:45
        // AM IN landed in AM-IN, the matching 12:45 PM OUT landed in
        // PM-OUT (because 12:45 is past the AM/PM boundary), and an
        // unrelated 4:15 PM badge IN landed in PM-IN, producing a "PM
        // session" with negative hours.
        //
        // New algorithm:
        //   1. Walk punches in time order, build (IN, OUT) pairs with a
        //      pendingIn state machine. IN-after-IN: the earlier becomes
        //      orphan (favors the later, manually-corrected IN over a
        //      duplicate badge IN). OUT with no pending IN: orphan. End
        //      of day with unmatched IN: orphan.
        //   2. Classify each pair by PLURALITY OF OVERLAP — whichever
        //      block contains the most session time wins. Keeps an
        //      extended AM shift (e.g. 7:45 AM IN + 5:30 PM OUT, with
        //      4h45m in AM, 4h in PM, 1h in Eve) anchored in AM where
        //      the IN naturally belongs, freeing PM/Eve for separate
        //      sessions. Also handles late-only shifts: 4:13 PM IN +
        //      9:00 PM OUT spends 4h30m in Eve vs 17m in PM, so the
        //      pair lands in Eve. Earlier midpoint-based version
        //      pushed long AM shifts past ~9.5 hours into PM IN slot
        //      where the morning IN looked alien.
        //   3. If the natural block is occupied, promote upward (AM→PM,
        //      PM→Eve). Never backward — an Eve session shouldn't show
        //      up in PM. If all upward blocks are full, send the pair
        //      to Extras together so both halves stay visible.
        //   4. Orphans always land in Extras (they aren't a session).
        //   5. Lunch punches act as session boundaries — a LunchOut
        //      closes the current pair and a LunchIn opens a new one,
        //      so a full-time hourly day with a lunch break renders as
        //      two clean pairs (AM IN→Lunch OUT, Lunch IN→Work OUT)
        //      that fall into AM and PM slots. Break punches still go
        //      to Extras (too short to meaningfully split a session).
        var view = new DaySlotView();
        var punches = day.Punches.OrderBy(p => p.PunchTime).ToList();

        var workPunches = new List<PunchEntry>();
        foreach (var p in punches)
        {
            if (p.PunchType is "BreakIn" or "BreakOut")
                view.Extras.Add(p);
            else
                workPunches.Add(p);
        }

        var pairs = new List<(PunchEntry In, PunchEntry Out)>();
        var orphans = new List<PunchEntry>();
        PunchEntry? pendingIn = null;

        foreach (var p in workPunches)
        {
            var isIn = p.PunchType is "In" or "LunchIn";
            var isOut = p.PunchType is "Out" or "LunchOut";

            if (isIn)
            {
                if (pendingIn != null) orphans.Add(pendingIn);
                pendingIn = p;
            }
            else if (isOut)
            {
                if (pendingIn != null)
                {
                    pairs.Add((pendingIn, p));
                    pendingIn = null;
                }
                else
                {
                    orphans.Add(p);
                }
            }
        }
        if (pendingIn != null) orphans.Add(pendingIn);

        foreach (var (inP, outP) in pairs)
        {
            var natural = ClassifyPair(inP.PunchTime, outP.PunchTime);
            if (!TryPlacePair(view, natural, inP, outP))
            {
                view.Extras.Add(inP);
                view.Extras.Add(outP);
            }
        }

        foreach (var o in orphans) view.Extras.Add(o);

        view.Extras = view.Extras.OrderBy(e => e.PunchTime).ToList();
        return view;
    }

    private static bool TryPlacePair(DaySlotView view, DayBlock natural, PunchEntry inP, PunchEntry outP)
    {
        DayBlock[] order = natural switch
        {
            DayBlock.Am => new[] { DayBlock.Am, DayBlock.Pm, DayBlock.Eve },
            DayBlock.Pm => new[] { DayBlock.Pm, DayBlock.Eve },
            _           => new[] { DayBlock.Eve }
        };

        foreach (var b in order)
        {
            if (b == DayBlock.Am && view.AmIn == null && view.AmOut == null)
            {
                view.AmIn = inP; view.AmOut = outP; return true;
            }
            if (b == DayBlock.Pm && view.PmIn == null && view.PmOut == null)
            {
                view.PmIn = inP; view.PmOut = outP; return true;
            }
            if (b == DayBlock.Eve && view.EveIn == null && view.EveOut == null)
            {
                view.EveIn = inP; view.EveOut = outP; return true;
            }
        }
        return false;
    }

    private static DayBlock ClassifyPair(DateTime inTime, DateTime outTime)
    {
        // Plurality of overlap — the pair lands in whichever block holds
        // the most session time. Block boundaries match ClassifyBlock:
        //   AM  = [00:00,         12:30 PM)
        //   PM  = [12:30 PM,       4:30 PM]
        //   Eve = ( 4:30 PM, end of day  ]
        // Boundary points contribute negligible time so >= ties favor the
        // earlier block (AM over PM, PM over Eve), which matches "where
        // the shift started" intuition for borderline cases.
        var date = inTime.Date;
        var amEnd = date.AddHours(12).AddMinutes(30);
        var pmEnd = date.AddHours(16).AddMinutes(30);
        var dayEnd = date.AddDays(1);

        long amOverlap = OverlapTicks(inTime, outTime, date, amEnd);
        long pmOverlap = OverlapTicks(inTime, outTime, amEnd, pmEnd);
        long eveOverlap = OverlapTicks(inTime, outTime, pmEnd, dayEnd);

        if (amOverlap >= pmOverlap && amOverlap >= eveOverlap) return DayBlock.Am;
        if (pmOverlap >= eveOverlap) return DayBlock.Pm;
        return DayBlock.Eve;
    }

    private static long OverlapTicks(DateTime aStart, DateTime aEnd, DateTime bStart, DateTime bEnd)
    {
        var start = aStart > bStart ? aStart : bStart;
        var end = aEnd < bEnd ? aEnd : bEnd;
        var diff = end - start;
        return diff.Ticks > 0 ? diff.Ticks : 0;
    }

    private static DayBlock ClassifyBlock(DateTime punchTime)
    {
        // Single-punch classifier. Retained for any future per-punch use
        // (no current callers since GetDaySlots switched to ClassifyPair).
        // Compare against minutes-since-midnight so the boundary checks read
        // like the schedule itself (12:30 PM = 750 min, 4:30 PM = 990 min).
        var minutes = punchTime.Hour * 60 + punchTime.Minute;
        if (minutes < 12 * 60 + 30) return DayBlock.Am;     // before 12:30 PM
        if (minutes <= 16 * 60 + 30) return DayBlock.Pm;    // 12:30 PM – 4:30 PM
        return DayBlock.Eve;                                 // after 4:30 PM
    }

    private enum DayBlock { Am, Pm, Eve }

    private class DaySlotView
    {
        public PunchEntry? AmIn { get; set; }
        public PunchEntry? AmOut { get; set; }
        public PunchEntry? PmIn { get; set; }
        public PunchEntry? PmOut { get; set; }
        public PunchEntry? EveIn { get; set; }
        public PunchEntry? EveOut { get; set; }
        public List<PunchEntry> Extras { get; set; } = new();

        // Hours per block — only computed when both In and Out are filled.
        // Returns "—" otherwise so the column reads the same way as the CSV
        // import preview when a slot is incomplete.
        public string AmHours => HoursOrDash(AmIn, AmOut);
        public string PmHours => HoursOrDash(PmIn, PmOut);
        public string EveHours => HoursOrDash(EveIn, EveOut);

        private static string HoursOrDash(PunchEntry? inP, PunchEntry? outP)
        {
            if (inP == null || outP == null) return "—";
            var hours = (decimal)(outP.PunchTime - inP.PunchTime).TotalHours;
            return hours.ToString("F2");
        }
    }

    // Source label helper — distinguishes Badge / Manual / SYSTEM (auto-out)
    // / Modified so the supervisor can tell at a glance which 9:00 PM OUTs
    // came from the auto-checkout loop vs an actual scan.
    private static (string Label, string Css) SourceTag(PunchEntry p)
    {
        if (p.IsAutoCheckout) return ("SYSTEM", "auto-system");
        if (p.IsManual) return ("Manual", "manual");
        if (p.IsModified) return ("Modified", "modified");
        return ("Badge", "auto");
    }

    // ── Void-punch flow ───────────────────────────────────────────────
    // Soft-delete model: clicking 🗑 on any slot or extras row queues the
    // punch in `pendingVoidPunchId` and pre-fills + opens the existing
    // Add Correction modal. The supervisor types a reason and clicks Save.
    // SaveCorrection then VOIDS the punch (PunchStatus = Voided), audits
    // the action, and clears any paired-punch linkage. The audit row
    // preserves the original PunchTime + reason for HR investigations.

    private long? pendingVoidPunchId;
    private string pendingVoidPunchSummary = "";

    private void OpenVoidPunchDialog(DailyTimesheetEntry day, PunchEntry punch)
    {
        editingDay = day;
        pendingVoidPunchId = punch.PunchId;
        pendingVoidPunchSummary =
            $"{punch.PunchType} at {punch.PunchTime:h:mm tt} ({SourceTag(punch).Label})";
        correctionReason = "";
        addPunchInCorrection = false;
        markExceptionResolved = false;
        flagAsException = false;
        showEditModal = true;
    }

    private async Task ApproveCorrectionRequest(TcCorrectionRequest request)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var entity = await context.TcCorrectionRequests.FindAsync(request.RequestId);
            if (entity == null) return;

            entity.Status = CorrectionRequestStatus.Approved;
            entity.ReviewedBy = currentUserEmail;
            entity.ReviewedDate = DateTime.Now;

            TcTimePunch? newPunch = null;

            // If the request includes a punch to add, create the TcTimePunch
            if (request.RequestType == CorrectionRequestType.MissedPunch ||
                request.RequestType == CorrectionRequestType.AddPunch)
            {
                if (request.RequestedDateTime.HasValue && request.RequestedPunchType.HasValue)
                {
                    var employee = await context.TcEmployees.FindAsync(EmployeeId);
                    var punchDt = request.RequestedDateTime.Value;

                    newPunch = new TcTimePunch
                    {
                        EmployeeId = EmployeeId,
                        CampusId = employee?.HomeCampusId ?? 0,
                        PunchType = request.RequestedPunchType.Value,
                        PunchDateTime = punchDt,
                        RoundedDateTime = RoundToQuarterHour(punchDt),
                        VerificationMethod = "MANUAL",
                        ScanMethod = "CORRECTION",
                        IsManualEntry = true,
                        IsModified = true,
                        ModifiedBy = currentUserEmail,
                        ModifiedReason = $"[Approved Correction] {request.Reason}",
                        Notes = request.Reason,
                        PunchStatus = PunchStatus.Active,
                        CreatedDate = DateTime.Now
                    };
                    context.TcTimePunches.Add(newPunch);
                }
            }

            await context.SaveChangesAsync();

            // Audit: CORRECTION_APPROVED row tagged with the supervisor.
            await Audit.LogActionAsync(
                actionCode: AuditActions.Correction.Approved,
                entityType: AuditEntityTypes.Correction,
                entityId: entity.RequestId.ToString(),
                newValues: new
                {
                    entity.RequestId,
                    entity.EmployeeId,
                    RequestType = entity.RequestType.ToString(),
                    WorkDate = entity.WorkDate.ToString("yyyy-MM-dd"),
                    RequestedPunchType = entity.RequestedPunchType?.ToString(),
                    RequestedDateTime = entity.RequestedDateTime?.ToString("yyyy-MM-dd HH:mm:ss"),
                    ReviewedBy = entity.ReviewedBy,
                    ReviewedDate = entity.ReviewedDate?.ToString("yyyy-MM-dd HH:mm:ss"),
                    CreatedPunchId = newPunch?.PunchId
                },
                reason: entity.Reason,
                deltaSummary:
                    $"Correction #{entity.RequestId} ({entity.RequestType}) for employee {EmployeeId} "
                    + $"approved by {currentUserEmail}"
                    + (newPunch != null ? $"; punch #{newPunch.PunchId} created" : ""),
                source: AuditSource.AdminUi,
                employeeId: EmployeeId);

            // If a punch was applied as a result, also emit CORRECTION_APPLIED.
            if (newPunch != null)
            {
                await Audit.LogActionAsync(
                    actionCode: AuditActions.Correction.Applied,
                    entityType: AuditEntityTypes.Punch,
                    entityId: newPunch.PunchId.ToString(),
                    newValues: new
                    {
                        newPunch.PunchId,
                        newPunch.EmployeeId,
                        newPunch.CampusId,
                        PunchType = newPunch.PunchType.ToString(),
                        newPunch.PunchDateTime,
                        SourceCorrectionId = entity.RequestId
                    },
                    deltaSummary:
                        $"Applied correction #{entity.RequestId}: new {newPunch.PunchType} punch at {newPunch.PunchDateTime:MMM d h:mm tt}",
                    source: AuditSource.AdminUi,
                    employeeId: EmployeeId,
                    punchId: newPunch.PunchId);
            }

            // Recalculate daily timecard
            await TimesheetService.RecalculateDailyTimecardAsync(EmployeeId, request.WorkDate);

            Logger.LogInformation("Supervisor {Sup} approved correction {Id} for employee {Emp}",
                currentUserEmail, request.RequestId, EmployeeId);

            // Email notification to the employee. Wrapped in try/catch so a mail
            // delivery failure (SMTP hiccup, wrong address) cannot break the
            // correction workflow — the DB writes + audit row are already committed.
            if (!string.IsNullOrWhiteSpace(employeeEmail))
            {
                try
                {
                    await EmailService.SendCorrectionApprovedAsync(
                        employeeEmail,
                        employeeName,
                        currentUserName,
                        FormatRequestType(entity.RequestType),
                        entity.WorkDate,
                        entity.Reason ?? "",
                        newPunch?.PunchDateTime,
                        newPunch?.PunchType.ToString());
                }
                catch (Exception mailEx)
                {
                    Logger.LogError(mailEx,
                        "Correction-approved email failed for employee {EmployeeId} correction {RequestId}. Decision already committed.",
                        EmployeeId, request.RequestId);
                }
            }

            await LoadTimesheet();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error approving correction request {Id}", request.RequestId);
        }
    }

    private async Task DenyCorrectionRequest(TcCorrectionRequest request)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var entity = await context.TcCorrectionRequests.FindAsync(request.RequestId);
            if (entity == null) return;

            var oldStatus = entity.Status;
            entity.Status = CorrectionRequestStatus.Denied;
            entity.ReviewedBy = currentUserEmail;
            entity.ReviewedDate = DateTime.Now;

            await context.SaveChangesAsync();

            await Audit.LogActionAsync(
                actionCode: AuditActions.Correction.Denied,
                entityType: AuditEntityTypes.Correction,
                entityId: entity.RequestId.ToString(),
                oldValues: new { Status = oldStatus.ToString() },
                newValues: new
                {
                    entity.RequestId,
                    entity.EmployeeId,
                    RequestType = entity.RequestType.ToString(),
                    WorkDate = entity.WorkDate.ToString("yyyy-MM-dd"),
                    Status = entity.Status.ToString(),
                    ReviewedBy = entity.ReviewedBy,
                    ReviewedDate = entity.ReviewedDate?.ToString("yyyy-MM-dd HH:mm:ss")
                },
                reason: entity.Reason,
                deltaSummary:
                    $"Correction #{entity.RequestId} ({entity.RequestType}) for employee {EmployeeId} denied by {currentUserEmail}",
                source: AuditSource.AdminUi,
                employeeId: EmployeeId);

            Logger.LogInformation("Supervisor {Sup} denied correction {Id} for employee {Emp}",
                currentUserEmail, request.RequestId, EmployeeId);

            // Email notification to the employee — same safety-first pattern as the
            // approve path. DB + audit are already committed; mail failures are logged.
            if (!string.IsNullOrWhiteSpace(employeeEmail))
            {
                try
                {
                    await EmailService.SendCorrectionDeniedAsync(
                        employeeEmail,
                        employeeName,
                        currentUserName,
                        FormatRequestType(entity.RequestType),
                        entity.WorkDate,
                        entity.Reason ?? "");
                }
                catch (Exception mailEx)
                {
                    Logger.LogError(mailEx,
                        "Correction-denied email failed for employee {EmployeeId} correction {RequestId}. Decision already committed.",
                        EmployeeId, request.RequestId);
                }
            }

            await LoadTimesheet();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error denying correction request {Id}", request.RequestId);
        }
    }

    private static string FormatRequestType(CorrectionRequestType type) => type switch
    {
        CorrectionRequestType.MissedPunch => "Missed Punch",
        CorrectionRequestType.WrongTime => "Wrong Time",
        CorrectionRequestType.WrongType => "Wrong Type",
        CorrectionRequestType.AddPunch => "Add Punch",
        CorrectionRequestType.DeletePunch => "Delete Punch",
        _ => type.ToString()
    };

    private string GetShiftStatus(DailyTimesheetEntry day, string shift)
    {
        // 2026-04-28: Aligned to ClassifyBlock so the collapsed-row pills
        // use the same boundaries as the slot table (AM <12:30, PM 12:30–
        // 4:30, Eve >4:30). Previous version had Evening 16-22 overlapping
        // with PM 12-17, so a 4:45 PM punch could land in both pills.
        if (day.TotalHours == 0 && !day.Punches.Any())
        {
            if (day.Date.DayOfWeek == DayOfWeek.Saturday || day.Date.DayOfWeek == DayOfWeek.Sunday)
                return "N/A";
            return "—";
        }

        var targetBlock = shift switch
        {
            "AM"      => (DayBlock?)DayBlock.Am,
            "PM"      => (DayBlock?)DayBlock.Pm,
            "Evening" => (DayBlock?)DayBlock.Eve,
            _         => null
        };

        if (targetBlock != null && day.Punches.Any(p => ClassifyBlock(p.PunchTime) == targetBlock))
            return "In Office";

        return day.Date.DayOfWeek == DayOfWeek.Saturday || day.Date.DayOfWeek == DayOfWeek.Sunday ? "N/A" : "—";
    }

    private static string FormatPunchType(string punchType) => punchType switch
    {
        "In" => "IN",
        "Out" => "OUT",
        "LunchOut" => "L-Out",
        "LunchIn" => "L-In",
        _ => punchType
    };


    private static DateTime NavigatePeriod(DateTime anchor, int direction)
    {
        bool isFirstHalf = anchor.Day <= 15;
        if (direction < 0)
        {
            return isFirstHalf
                ? new DateTime(anchor.AddMonths(-1).Year, anchor.AddMonths(-1).Month, 16)
                : new DateTime(anchor.Year, anchor.Month, 1);
        }
        else
        {
            if (isFirstHalf)
                return new DateTime(anchor.Year, anchor.Month, 16);
            var next = anchor.AddMonths(1);
            return new DateTime(next.Year, next.Month, 1);
        }
    }
    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return parts.Length > 0 ? parts[0][0].ToString().ToUpper() : "?";
    }

    private static DateTime RoundToQuarterHour(DateTime dt)
    {
        var minutes = (int)(Math.Round(dt.Minute / 15.0) * 15);
        if (minutes == 60)
            return new DateTime(dt.Year, dt.Month, dt.Day, dt.Hour, 0, 0).AddHours(1);
        return new DateTime(dt.Year, dt.Month, dt.Day, dt.Hour, minutes, 0);
    }

