@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Nav

<CascadingAuthenticationState>
<div class="page @(isNavOpen ? "nav-open" : "")">

    <button class="nav-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="@(isNavOpen ? "true" : "false")"
            @onclick="ToggleNav">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
    </button>

    <div class="nav-scrim" @onclick="CloseNav"></div>

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* Need Help link — outside AuthorizeView so it appears for everyone,
               authenticated or not. Unauthenticated users tapping it land on
               /help which requires sign-in, so they will be redirected through
               Microsoft Identity sign-in and then to the help page. *@
            <a href="/help" class="help-link" title="Open the in-portal help system">
                <span aria-hidden="true">❓</span>
                <span>Need Help?</span>
            </a>
            <AuthorizeView>
                <Authorized>
                    <span class="user-name">@context.User.Identity?.Name</span>
                    <a href="MicrosoftIdentity/Account/SignOut">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="MicrosoftIdentity/Account/SignIn">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
</CascadingAuthenticationState>

@code {
    private bool isNavOpen;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void ToggleNav() => isNavOpen = !isNavOpen;

    private void CloseNav() => isNavOpen = false;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isNavOpen)
        {
            isNavOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
