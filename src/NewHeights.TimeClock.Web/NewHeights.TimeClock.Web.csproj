<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NewHeights.TimeClock.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.11" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.5.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.5.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.67.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="PDFsharp" Version="6.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="Azure.Communication.Sms" Version="1.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.11" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Security pins: patched transitive packages flagged by Defender for Cloud (2026-05-29).
       Kiota 1.22.0 = CVE-2026-44503; System.Security.Cryptography.Xml 8.0.3 = CVE-2026-33116 / CVE-2026-26171.
       SixLabors.ImageSharp removed by migrating PdfSharpCore -> PDFsharp 6 (see PayrollPdfService / TimeClockFontResolver). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.0" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.22.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.3" />
  </ItemGroup>

  <!-- Bundled fonts for PDFsharp 6 on Linux (TimeClockFontResolver). ADD these two TTFs to build. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\LiberationSans-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewHeights.TimeClock.Data\NewHeights.TimeClock.Data.csproj" />
    <ProjectReference Include="..\NewHeights.TimeClock.Shared\NewHeights.TimeClock.Shared.csproj" />
  </ItemGroup>

</Project>
